{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/signed-layered-v1.schema.json",
  "title": "Signed Layered World Location v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["worldSpace", "coordinate"],
  "properties": {
    "worldSpace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "level"],
      "properties": {
        "x": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "y": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "level": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
      }
    }
  }
}
