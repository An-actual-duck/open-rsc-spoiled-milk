{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-remastered.invalid/schema/layered-world-package-v1.schema.json",
  "title": "Native Layered World Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "packageId",
    "packageVersion",
    "coordinateModel",
    "storage",
    "worldSpaces",
    "levels",
    "terrainSectors",
    "placementSets"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "packageType": {"const": "layered-world"},
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9._-]+)?$"
    },
    "coordinateModel": {"const": "signed-layered-v1"},
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectorSize", "presentationChunkSize"],
      "properties": {
        "sectorSize": {"const": 48},
        "presentationChunkSize": {
          "type": "integer",
          "enum": [1, 2, 3, 4, 6, 8, 12, 16, 24, 48]
        }
      }
    },
    "worldSpaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "kind": {"enum": ["static", "instance-template"]}
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["worldSpace", "level", "name", "role"],
        "properties": {
          "worldSpace": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "level": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "terrainSectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "worldSpace",
          "level",
          "sectorX",
          "sectorY",
          "encoding",
          "path",
          "sha256"
        ],
        "properties": {
          "worldSpace": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "level": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "sectorX": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "sectorY": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "encoding": {
            "enum": [
              "uniform-layered-sector-v1",
              "rle-layered-sector-v1"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "placementSets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "worldSpace",
          "level",
          "encoding",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "worldSpace": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "level": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "encoding": {
            "enum": [
              "layered-entity-placements-v1",
              "layered-world-placements-v2"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
