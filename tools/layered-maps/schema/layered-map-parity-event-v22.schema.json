{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v22.schema.json",
  "title": "Layered Map Parity Event v22",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "packedRegionRetirementSafety",
    "packedRegionAuthoredConstruction", "packedRegionAuthoredProvenance",
    "packedRegionAuthoredReconstruction",
    "packedRegionAuthoredReconstructionCohort",
    "packedRegionAuthoredReconstructionCohortAttribution",
    "roundTripExact"
  ],
  "properties": {
    "schema": {"const": "layered-map-parity-event-v22"},
    "eventType": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/eventType"},
    "sequence": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/sequence"},
    "timestampEpochMillis": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/timestampEpochMillis"},
    "player": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/player"},
    "label": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/label"},
    "teleported": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/teleported"},
    "from": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/from"},
    "to": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/to"},
    "delta": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/delta"},
    "interestDelta": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/interestDelta"},
    "packedCoverage": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/packedCoverage"},
    "tileSnapshot": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/tileSnapshot"},
    "tileParity": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/tileParity"},
    "tileNeighborhood": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/tileNeighborhood"},
    "adjacentCollision": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/adjacentCollision"},
    "recentTraversal": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/recentTraversal"},
    "regionResidency": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/regionResidency"},
    "interestOwnership": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/interestOwnership"},
    "regionRetirement": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/regionRetirement"},
    "regionRetirementDecisions": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/regionRetirementDecisions"},
    "packedRegionRetirementReadiness": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/packedRegionRetirementReadiness"},
    "packedRegionRetirementSafety": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/packedRegionRetirementSafety"},
    "packedRegionAuthoredConstruction": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/packedRegionAuthoredConstruction"},
    "packedRegionAuthoredProvenance": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/packedRegionAuthoredProvenance"},
    "packedRegionAuthoredReconstruction": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/packedRegionAuthoredReconstruction"},
    "packedRegionAuthoredReconstructionCohort": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/packedRegionAuthoredReconstructionCohort"},
    "packedRegionAuthoredReconstructionCohortAttribution": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/cohortAttribution"}
      ]
    },
    "roundTripExact": {"$ref": "layered-map-parity-event-v21.schema.json#/properties/roundTripExact"}
  },
  "$defs": {
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "constructionKind": {
      "enum": [
        "SCENERY", "BOUNDARY", "NPC_SPAWN", "GROUND_ITEM_SPAWN",
        "HARVESTING_SCENERY"
      ]
    },
    "dependencyKind": {
      "enum": ["OBJECT_FOOTPRINT", "NPC_ROAMING", "ANCHOR_ONLY"]
    },
    "kindAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constructionKind", "dependencyKind", "placementCount",
        "crossSourcePlacementCount", "affectedSourceReferenceCount",
        "crossSourceReferenceCount", "expansionFrontierReferenceCount",
        "externalSupportReferenceCount"
      ],
      "properties": {
        "constructionKind": {"$ref": "#/$defs/constructionKind"},
        "dependencyKind": {"$ref": "#/$defs/dependencyKind"},
        "placementCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "crossSourcePlacementCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "affectedSourceReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "crossSourceReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "expansionFrontierReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "externalSupportReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"}
      }
    },
    "constructionKindReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "referenceCount"],
      "properties": {
        "kind": {"$ref": "#/$defs/constructionKind"},
        "referenceCount": {"type": "integer", "minimum": 1}
      }
    },
    "dependencyKindReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "referenceCount"],
      "properties": {
        "kind": {"$ref": "#/$defs/dependencyKind"},
        "referenceCount": {"type": "integer", "minimum": 1}
      }
    },
    "edgeAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerPackedRegionX", "ownerPackedRegionY", "ownerExpansionRound",
        "requiredPackedRegionX", "requiredPackedRegionY",
        "requiredExpansionRound", "selfReference", "cohortSource",
        "expansionFrontier", "externalSupportRequired",
        "placementReferenceCount", "constructionKindReferences",
        "dependencyKindReferences"
      ],
      "properties": {
        "ownerPackedRegionX": {"type": "integer"},
        "ownerPackedRegionY": {"type": "integer"},
        "ownerExpansionRound": {"$ref": "#/$defs/nonNegativeInteger"},
        "requiredPackedRegionX": {"type": "integer"},
        "requiredPackedRegionY": {"type": "integer"},
        "requiredExpansionRound": {"type": "integer", "minimum": -1},
        "selfReference": {"type": "boolean"},
        "cohortSource": {"type": "boolean"},
        "expansionFrontier": {"type": "boolean"},
        "externalSupportRequired": {"type": "boolean"},
        "placementReferenceCount": {"type": "integer", "minimum": 1},
        "constructionKindReferences": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {"$ref": "#/$defs/constructionKindReference"}
        },
        "dependencyKindReferences": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {"$ref": "#/$defs/dependencyKindReference"}
        }
      }
    },
    "bridgePlacementAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityGeneration", "ownerPackedRegionX", "ownerPackedRegionY",
        "ownerExpansionRound", "sourceOrdinal", "constructionKind",
        "dependencyKind", "authoredDefinitionId", "constructedEntityId",
        "minimumPackedRegionX", "maximumPackedRegionX",
        "minimumPackedRegionY", "maximumPackedRegionY",
        "affectedSourceCount", "cohortRequirementSourceCount",
        "expansionFrontierSourceCount",
        "externalSupportRequirementSourceCount"
      ],
      "properties": {
        "identityGeneration": {"type": "integer", "minimum": 1},
        "ownerPackedRegionX": {"type": "integer"},
        "ownerPackedRegionY": {"type": "integer"},
        "ownerExpansionRound": {"$ref": "#/$defs/nonNegativeInteger"},
        "sourceOrdinal": {"type": "integer", "minimum": 1},
        "constructionKind": {"$ref": "#/$defs/constructionKind"},
        "dependencyKind": {"$ref": "#/$defs/dependencyKind"},
        "authoredDefinitionId": {"type": "integer"},
        "constructedEntityId": {"type": "integer"},
        "minimumPackedRegionX": {"type": "integer"},
        "maximumPackedRegionX": {"type": "integer"},
        "minimumPackedRegionY": {"type": "integer"},
        "maximumPackedRegionY": {"type": "integer"},
        "affectedSourceCount": {"type": "integer", "minimum": 2},
        "cohortRequirementSourceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "expansionFrontierSourceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "externalSupportRequirementSourceCount": {"$ref": "#/$defs/nonNegativeInteger"}
      }
    },
    "cohortAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation", "safetyObservedAtTick", "kindCount", "edgeCount",
        "bridgePlacementCount", "placementCount",
        "crossSourcePlacementCount", "affectedSourceReferenceCount",
        "crossSourceReferenceCount", "expansionFrontierReferenceCount",
        "externalSupportReferenceCount", "selfEdgeCount",
        "expansionFrontierEdgeCount", "externalSupportEdgeCount",
        "identityMetadataOnly", "entityRegistry", "lifecycleAuthority",
        "kinds", "edges", "bridgePlacements"
      ],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "safetyObservedAtTick": {"type": "integer", "minimum": 0},
        "kindCount": {"type": "integer", "minimum": 0, "maximum": 15},
        "edgeCount": {"type": "integer", "minimum": 0, "maximum": 8192},
        "bridgePlacementCount": {"type": "integer", "minimum": 0, "maximum": 8192},
        "placementCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "crossSourcePlacementCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "affectedSourceReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "crossSourceReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "expansionFrontierReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "externalSupportReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "selfEdgeCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "expansionFrontierEdgeCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "externalSupportEdgeCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "identityMetadataOnly": {"const": true},
        "entityRegistry": {"const": false},
        "lifecycleAuthority": {"const": false},
        "kinds": {
          "type": "array", "maxItems": 15,
          "items": {"$ref": "#/$defs/kindAttribution"}
        },
        "edges": {
          "type": "array", "maxItems": 8192,
          "items": {"$ref": "#/$defs/edgeAttribution"}
        },
        "bridgePlacements": {
          "type": "array", "maxItems": 8192,
          "items": {"$ref": "#/$defs/bridgePlacementAttribution"}
        }
      }
    }
  }
}
