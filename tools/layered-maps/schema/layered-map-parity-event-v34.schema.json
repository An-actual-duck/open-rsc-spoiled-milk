      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "permanentObjectId",
        "packedX",
        "packedY",
        "direction",
        "type",
        "ownerPresent",
        "runtimeAttributeCount",
        "constructorStateComplete",
        "authoredPlacement"
      ],
      "properties": {
        "objectId": {
          "type": "integer",
          "minimum": 0
        },
        "permanentObjectId": {
          "type": "integer",
          "minimum": 0
        },
        "packedX": {
          "type": "integer",
          "minimum": 0
        },
        "packedY": {
          "type": "integer",
          "minimum": 0
        },
        "direction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "type": {
          "enum": [
            0,
            1
          ]
        },
        "ownerPresent": {
          "type": "boolean"
        },
        "runtimeAttributeCount": {
          "type": "integer",
          "minimum": 0
        },
        "constructorStateComplete": {
          "const": true
        },
        "authoredPlacement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/authoredPlacement"
            }
          ]
        }
      }
    },
    "authoredPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "packedRegionX",
        "packedRegionY",
        "sourceOrdinal",
        "constructionKind"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "packedRegionX": {
          "type": "integer",
          "minimum": 0
        },
        "packedRegionY": {
          "type": "integer",
          "minimum": 0
        },
        "sourceOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "constructionKind": {
          "enum": [
            "SCENERY",
            "BOUNDARY",
            "NPC_SPAWN",
            "GROUND_ITEM_SPAWN",
            "HARVESTING_SCENERY"
          ]
        }
      }
    },
    "spatialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "packedX",
        "packedY"
      ],
      "properties": {
        "role": {
          "enum": [
            "OWNER_CURRENT_POSITION",
            "SUBJECT_CURRENT_POSITION",
            "TARGET_CURRENT_POSITION",
            "FIXED_EFFECT_LOCATION"
          ]
        },
        "packedX": {
          "type": "integer",
          "minimum": 0
        },
        "packedY": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
