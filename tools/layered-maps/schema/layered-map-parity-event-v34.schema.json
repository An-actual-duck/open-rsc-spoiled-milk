          "$ref": "#/$defs/boundedEventCount"
        },
        "attributionComplete": {
          "type": "boolean"
        }
      }
    },
    "eventRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotOrdinal",
        "registrationSequence",
        "ownerKind",
        "attributionKind",
        "running",
        "ticksBeforeRun",
        "timesRan",
        "candidateRelated",
        "attributionComplete",
        "restorationStateComplete",
        "restorationState",
        "candidateSourceOrdinals",
        "spatialReferences"
      ],
      "properties": {
        "snapshotOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "registrationSequence": {
          "type": "integer",
          "minimum": 1
        },
        "ownerKind": {
          "enum": [
            "NONE",
            "PLAYER",
            "NPC"
          ]
        },
        "attributionKind": {
          "enum": [
            "EXACT_SPATIAL",
            "OWNER_POSITION_HINT",
            "NON_SPATIAL_GLOBAL",
            "UNATTRIBUTED"
          ]
        },
        "running": {
          "type": "boolean"
        },
        "ticksBeforeRun": {
          "type": "integer"
        },
        "timesRan": {
          "type": "integer",
          "minimum": 0
        },
        "candidateRelated": {
          "type": "boolean"
        },
        "attributionComplete": {
          "type": "boolean"
        },
        "restorationStateComplete": {
          "const": false
        },
        "restorationState": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/restorationState"
            }
          ]
        },
        "candidateSourceOrdinals": {
          "$ref": "#/$defs/ordinalList"
        },
        "spatialReferences": {
          "type": "array",
          "maxItems": 262144,
          "items": {
            "$ref": "#/$defs/spatialReference"
          }
        }
      }
    },
