        },
        "eventCount": {
          "$ref": "#/$defs/boundedEventCount"
        },
        "spatialReferenceCount": {
          "$ref": "#/$defs/boundedReferenceCount"
        },
        "exactSpatialEventCount": {
          "$ref": "#/$defs/boundedEventCount"
        },
        "ownerPositionHintEventCount": {
          "$ref": "#/$defs/boundedEventCount"
        },
        "nonSpatialGlobalEventCount": {
          "$ref": "#/$defs/boundedEventCount"
