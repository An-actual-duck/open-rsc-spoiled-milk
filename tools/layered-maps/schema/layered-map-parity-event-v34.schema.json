        "detachedCallbackPayloadCompleteEventCount": {
          "$ref": "#/$defs/boundedEventCount"
        },
        "candidateAttributionComplete": {
          "type": "boolean"
        },
        "restorationStateCompleteEventCount": {
          "const": 0
        },
        "pointInTimeOnly": {
          "const": true
        },
        "detachedPrimitiveCopy": {
          "const": true
        },
        "callbackStateCaptured": {
          "const": false
        },
        "schedulerIdentityCaptured": {
          "const": false
        },
        "preservationPerformed": {
          "const": false
        },
        "reloadRequest": {
          "const": false
        },
        "eventCancellation": {
          "const": false
        },
        "eventReschedule": {
          "const": false
        },
        "entityRegistry": {
          "const": false
        },
        "arrivalGate": {
          "const": false
        },
        "teardownTransaction": {
          "const": false
        },
