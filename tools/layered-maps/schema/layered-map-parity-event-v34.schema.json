          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/eventSource"
          }
        },
        "events": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/eventRecord"
          }
        }
      }
    },
    "eventSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packedRegionX",
        "packedRegionY",
        "exactSpatialEventCount",
        "exactSpatialEventOrdinals",
        "ownerPositionHintEventCount",
        "ownerPositionHintEventOrdinals",
        "restorationStateEventCount",
        "restorationStateEventOrdinals",
        "unattributedEventCount",
        "attributionComplete"
      ],
      "properties": {
        "packedRegionX": {
          "type": "integer",
          "minimum": 0
