    "ordinalList": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "eventOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
