        "exactSpatialEventCount": {
          "$ref": "#/$defs/boundedEventCount"
        },
        "exactSpatialEventOrdinals": {
          "$ref": "#/$defs/ordinalList"
        },
        "ownerPositionHintEventCount": {
          "$ref": "#/$defs/boundedEventCount"
        },
        "ownerPositionHintEventOrdinals": {
          "$ref": "#/$defs/ordinalList"
        },
        "restorationStateEventCount": {
          "$ref": "#/$defs/boundedEventCount"
        },
        "restorationStateEventOrdinals": {
          "$ref": "#/$defs/ordinalList"
        },
