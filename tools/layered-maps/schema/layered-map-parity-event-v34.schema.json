      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "forceFullBlock",
        "targetBindingEvidence",
        "detachedCallbackPayloadComplete",
        "schedulerIdentityCaptured",
        "targetBindingLookupPerformed",
        "standaloneRestorationComplete",
        "scenery"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SCENERY_SPAWN",
            "SCENERY_REMOVE"
          ]
        },
        "forceFullBlock": {
          "type": "boolean"
        },
        "targetBindingEvidence": {
          "enum": [
            "NOT_REQUIRED",
            "AUTHORED_PLACEMENT_IDENTITY",
            "LIVE_ENTITY_REFERENCE_ONLY"
          ]
        },
        "detachedCallbackPayloadComplete": {
          "type": "boolean"
        },
        "schedulerIdentityCaptured": {
          "const": false
        },
        "targetBindingLookupPerformed": {
          "const": false
        },
        "standaloneRestorationComplete": {
          "const": false
        },
