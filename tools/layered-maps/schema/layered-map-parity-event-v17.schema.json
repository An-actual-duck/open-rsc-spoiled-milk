{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v17.schema.json",
  "title": "Layered Map Parity Event v17",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "packedRegionRetirementSafety",
    "packedRegionAuthoredConstruction", "packedRegionAuthoredProvenance",
    "roundTripExact"
  ],
  "properties": {
    "schema": {"const": "layered-map-parity-event-v17"},
    "eventType": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/eventType"},
    "sequence": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/sequence"},
    "timestampEpochMillis": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/timestampEpochMillis"},
    "player": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/player"},
    "label": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/label"},
    "teleported": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/teleported"},
    "from": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/from"},
    "to": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/to"},
    "delta": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/delta"},
    "interestDelta": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/interestDelta"},
    "packedCoverage": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/packedCoverage"},
    "tileSnapshot": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/tileSnapshot"},
    "tileParity": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/tileParity"},
    "tileNeighborhood": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/tileNeighborhood"},
    "adjacentCollision": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/adjacentCollision"},
    "recentTraversal": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/recentTraversal"},
    "regionResidency": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/regionResidency"},
    "interestOwnership": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/interestOwnership"},
    "regionRetirement": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/regionRetirement"},
    "regionRetirementDecisions": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/regionRetirementDecisions"},
    "packedRegionRetirementReadiness": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/packedRegionRetirementReadiness"},
    "packedRegionRetirementSafety": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/packedRegionRetirementSafety"},
    "packedRegionAuthoredConstruction": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/packedRegionAuthoredConstruction"},
    "packedRegionAuthoredProvenance": {
      "oneOf": [
        {"$ref": "#/$defs/packedRegionAuthoredProvenance"},
        {"type": "null"}
      ]
    },
    "roundTripExact": {"$ref": "layered-map-parity-event-v16.schema.json#/properties/roundTripExact"}
  },
  "allOf": [
    {"$ref": "layered-map-parity-event-v16.schema.json#/allOf/0"},
    {"$ref": "layered-map-parity-event-v16.schema.json#/allOf/1"},
    {"$ref": "layered-map-parity-event-v16.schema.json#/allOf/2"},
    {"$ref": "layered-map-parity-event-v16.schema.json#/allOf/3"},
    {"$ref": "layered-map-parity-event-v16.schema.json#/allOf/4"},
    {"$ref": "layered-map-parity-event-v16.schema.json#/allOf/5"},
    {
      "if": {"properties": {"packedRegionRetirementSafety": {"type": "null"}}},
      "then": {
        "properties": {"packedRegionAuthoredProvenance": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "packedRegionAuthoredProvenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packedRegionX", "packedRegionY", "expectedPlacementCount",
        "matchedIdentityCount", "absentIdentityCount",
        "duplicateIdentityCount", "runtimeInstanceCount",
        "activeRuntimeInstanceCount", "inactiveRuntimeInstanceCount",
        "atAuthoredSourceInstanceCount", "awayFromAuthoredSourceInstanceCount",
        "replacementObjectInstanceCount", "staleGenerationInstanceCount",
        "unrecognizedIdentityInstanceCount", "expectedSceneryCount",
        "expectedBoundaryCount", "expectedNpcSpawnCount",
        "expectedGroundItemSpawnCount", "expectedHarvestingSceneryCount",
        "runtimeSceneryCount", "runtimeBoundaryCount", "runtimeNpcSpawnCount",
        "runtimeGroundItemSpawnCount", "runtimeHarvestingSceneryCount"
      ],
      "properties": {
        "packedRegionX": {"type": "integer", "minimum": 0},
        "packedRegionY": {"type": "integer", "minimum": 0},
        "expectedPlacementCount": {"type": "integer", "minimum": 0},
        "matchedIdentityCount": {"type": "integer", "minimum": 0},
        "absentIdentityCount": {"type": "integer", "minimum": 0},
        "duplicateIdentityCount": {"type": "integer", "minimum": 0},
        "runtimeInstanceCount": {"type": "integer", "minimum": 0},
        "activeRuntimeInstanceCount": {"type": "integer", "minimum": 0},
        "inactiveRuntimeInstanceCount": {"type": "integer", "minimum": 0},
        "atAuthoredSourceInstanceCount": {"type": "integer", "minimum": 0},
        "awayFromAuthoredSourceInstanceCount": {"type": "integer", "minimum": 0},
        "replacementObjectInstanceCount": {"type": "integer", "minimum": 0},
        "staleGenerationInstanceCount": {"type": "integer", "minimum": 0},
        "unrecognizedIdentityInstanceCount": {"type": "integer", "minimum": 0},
        "expectedSceneryCount": {"type": "integer", "minimum": 0},
        "expectedBoundaryCount": {"type": "integer", "minimum": 0},
        "expectedNpcSpawnCount": {"type": "integer", "minimum": 0},
        "expectedGroundItemSpawnCount": {"type": "integer", "minimum": 0},
        "expectedHarvestingSceneryCount": {"type": "integer", "minimum": 0},
        "runtimeSceneryCount": {"type": "integer", "minimum": 0},
        "runtimeBoundaryCount": {"type": "integer", "minimum": 0},
        "runtimeNpcSpawnCount": {"type": "integer", "minimum": 0},
        "runtimeGroundItemSpawnCount": {"type": "integer", "minimum": 0},
        "runtimeHarvestingSceneryCount": {"type": "integer", "minimum": 0}
      }
    },
    "packedRegionAuthoredProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation", "safetyObservedAtTick", "runtimeObservedAtTick",
        "sourceCount", "expectedPlacementCount", "matchedIdentityCount",
        "absentIdentityCount", "duplicateIdentityCount", "runtimeInstanceCount",
        "activeRuntimeInstanceCount", "inactiveRuntimeInstanceCount",
        "atAuthoredSourceInstanceCount", "awayFromAuthoredSourceInstanceCount",
        "replacementObjectInstanceCount", "staleGenerationInstanceCount",
        "unrecognizedIdentityInstanceCount", "expectedSceneryCount",
        "expectedBoundaryCount", "expectedNpcSpawnCount",
        "expectedGroundItemSpawnCount", "expectedHarvestingSceneryCount",
        "runtimeSceneryCount", "runtimeBoundaryCount", "runtimeNpcSpawnCount",
        "runtimeGroundItemSpawnCount", "runtimeHarvestingSceneryCount",
        "identityMetadataOnly", "entityRegistry", "lifecycleAuthority", "entries"
      ],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "safetyObservedAtTick": {"type": "integer", "minimum": 0},
        "runtimeObservedAtTick": {"type": "integer", "minimum": 0},
        "sourceCount": {"type": "integer", "minimum": 0, "maximum": 8192},
        "expectedPlacementCount": {"type": "integer", "minimum": 0},
        "matchedIdentityCount": {"type": "integer", "minimum": 0},
        "absentIdentityCount": {"type": "integer", "minimum": 0},
        "duplicateIdentityCount": {"type": "integer", "minimum": 0},
        "runtimeInstanceCount": {"type": "integer", "minimum": 0, "maximum": 524288},
        "activeRuntimeInstanceCount": {"type": "integer", "minimum": 0},
        "inactiveRuntimeInstanceCount": {"type": "integer", "minimum": 0},
        "atAuthoredSourceInstanceCount": {"type": "integer", "minimum": 0},
        "awayFromAuthoredSourceInstanceCount": {"type": "integer", "minimum": 0},
        "replacementObjectInstanceCount": {"type": "integer", "minimum": 0},
        "staleGenerationInstanceCount": {"type": "integer", "minimum": 0},
        "unrecognizedIdentityInstanceCount": {"type": "integer", "minimum": 0},
        "expectedSceneryCount": {"type": "integer", "minimum": 0},
        "expectedBoundaryCount": {"type": "integer", "minimum": 0},
        "expectedNpcSpawnCount": {"type": "integer", "minimum": 0},
        "expectedGroundItemSpawnCount": {"type": "integer", "minimum": 0},
        "expectedHarvestingSceneryCount": {"type": "integer", "minimum": 0},
        "runtimeSceneryCount": {"type": "integer", "minimum": 0},
        "runtimeBoundaryCount": {"type": "integer", "minimum": 0},
        "runtimeNpcSpawnCount": {"type": "integer", "minimum": 0},
        "runtimeGroundItemSpawnCount": {"type": "integer", "minimum": 0},
        "runtimeHarvestingSceneryCount": {"type": "integer", "minimum": 0},
        "identityMetadataOnly": {"const": true},
        "entityRegistry": {"const": false},
        "lifecycleAuthority": {"const": false},
        "entries": {
          "type": "array",
          "maxItems": 8192,
          "items": {"$ref": "#/$defs/packedRegionAuthoredProvenanceEntry"}
        }
      }
    }
  }
}
