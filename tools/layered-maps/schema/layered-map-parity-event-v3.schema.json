{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v3.schema.json",
  "title": "Layered Map Parity Event v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "eventType",
    "sequence",
    "timestampEpochMillis",
    "player",
    "label",
    "teleported",
    "from",
    "to",
    "delta",
    "interestDelta",
    "roundTripExact"
  ],
  "properties": {
    "schema": {"const": "layered-map-parity-event-v3"},
    "eventType": {
      "enum": ["start", "snapshot", "marker", "move", "teleport", "login", "logout", "stop"]
    },
    "sequence": {"type": "integer", "minimum": 1},
    "timestampEpochMillis": {"type": "integer", "minimum": 0},
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseId", "usernameHash"],
      "properties": {
        "databaseId": {"type": "integer", "minimum": 0},
        "usernameHash": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "label": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "teleported": {"type": ["boolean", "null"]},
    "from": {"oneOf": [{"$ref": "#/$defs/snapshot"}, {"type": "null"}]},
    "to": {"$ref": "#/$defs/snapshot"},
    "delta": {"oneOf": [{"$ref": "#/$defs/delta"}, {"type": "null"}]},
    "interestDelta": {
      "oneOf": [{"$ref": "#/$defs/interestDelta"}, {"type": "null"}]
    },
    "roundTripExact": {"const": true}
  },
  "$defs": {
    "xy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"}
      }
    },
    "layered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldSpace", "x", "y", "level"],
      "properties": {
        "worldSpace": {"const": "global"},
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "level": {"enum": [-1, 0, 1, 2]}
      }
    },
    "regionKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldSpace", "level", "x", "y"],
      "properties": {
        "worldSpace": {"const": "global"},
        "level": {"enum": [-1, 0, 1, 2]},
        "x": {"type": "integer"},
        "y": {"type": "integer"}
      }
    },
    "visibilityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldSpace",
        "level",
        "gridDistance",
        "tileRadius",
        "minRegionX",
        "minRegionY",
        "maxRegionX",
        "maxRegionY",
        "regionCount"
      ],
      "properties": {
        "worldSpace": {"const": "global"},
        "level": {"enum": [-1, 0, 1, 2]},
        "gridDistance": {"type": "integer", "minimum": 0},
        "tileRadius": {"type": "integer", "minimum": 0},
        "minRegionX": {"type": "integer"},
        "minRegionY": {"type": "integer"},
        "maxRegionX": {"type": "integer"},
        "maxRegionY": {"type": "integer"},
        "regionCount": {"type": "integer", "minimum": 1}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy",
        "layered",
        "region",
        "terrainSector",
        "local",
        "visibilityWindow",
        "roundTripExact"
      ],
      "properties": {
        "legacy": {"$ref": "#/$defs/xy"},
        "layered": {"$ref": "#/$defs/layered"},
        "region": {"$ref": "#/$defs/xy"},
        "terrainSector": {"$ref": "#/$defs/xy"},
        "local": {"$ref": "#/$defs/xy"},
        "visibilityWindow": {"$ref": "#/$defs/visibilityWindow"},
        "roundTripExact": {"const": true}
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "level"],
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "level": {"type": "integer"}
      }
    },
    "interestDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previousRegionCount",
        "currentRegionCount",
        "enteredCount",
        "retainedCount",
        "exitedCount",
        "worldSpaceChanged",
        "levelChanged",
        "noOp",
        "enteredKeys",
        "exitedKeys"
      ],
      "properties": {
        "previousRegionCount": {"type": "integer", "minimum": 1},
        "currentRegionCount": {"type": "integer", "minimum": 1},
        "enteredCount": {"type": "integer", "minimum": 0},
        "retainedCount": {"type": "integer", "minimum": 0},
        "exitedCount": {"type": "integer", "minimum": 0},
        "worldSpaceChanged": {"type": "boolean"},
        "levelChanged": {"type": "boolean"},
        "noOp": {"type": "boolean"},
        "enteredKeys": {
          "type": "array",
          "items": {"$ref": "#/$defs/regionKey"}
        },
        "exitedKeys": {
          "type": "array",
          "items": {"$ref": "#/$defs/regionKey"}
        }
      }
    }
  }
}
