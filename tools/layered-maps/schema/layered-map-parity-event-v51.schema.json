{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v51.schema.json",
  "title": "Layered Map Parity Event v51",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "packedRegionRetirementSafety",
    "packedRegionAuthoredConstruction", "packedRegionAuthoredProvenance",
    "packedRegionAuthoredReconstruction",
    "packedRegionAuthoredReconstructionCohort",
    "packedRegionAuthoredReconstructionCohortAttribution",
    "packedRegionAuthoredReconstructionTopology",
    "packedRegionAuthoredReconstructionDependencySemantics",
    "packedRegionActiveNpcResidency", "packedRegionActiveNpcContainment",
    "packedRegionActiveNpcBoundaryRequirements",
    "packedRegionRetirementRefinement",
    "packedRegionRetirementRefinementReassessment",
    "packedRegionPreservationBurden",
    "packedRegionDynamicObjectPreservation", "packedRegionEventOwnership",
    "packedRegionNpcOwnerEventContinuity",
    "packedRegionNpcOwnerPreservationBoundary",
    "packedRegionNpcOwnerPreservationNoOp", "packedRegionEventTargets",
    "packedRegionEventAtomicTargetRevalidation",
    "packedRegionEventRecoveryNoOp", "roundTripExact"
  ],
  "properties": {
    "schema": { "const": "layered-map-parity-event-v51" },
    "eventType": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/eventType" },
    "sequence": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/sequence" },
    "timestampEpochMillis": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/timestampEpochMillis" },
    "player": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/player" },
    "label": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/label" },
    "teleported": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/teleported" },
    "from": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/from" },
    "to": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/to" },
    "delta": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/delta" },
    "interestDelta": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/interestDelta" },
    "packedCoverage": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedCoverage" },
    "tileSnapshot": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/tileSnapshot" },
    "tileParity": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/tileParity" },
    "tileNeighborhood": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/tileNeighborhood" },
    "adjacentCollision": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/adjacentCollision" },
    "recentTraversal": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/recentTraversal" },
    "regionResidency": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/regionResidency" },
    "interestOwnership": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/interestOwnership" },
    "regionRetirement": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/regionRetirement" },
    "regionRetirementDecisions": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/regionRetirementDecisions" },
    "packedRegionRetirementReadiness": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionRetirementReadiness" },
    "packedRegionRetirementSafety": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionRetirementSafety" },
    "packedRegionAuthoredConstruction": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionAuthoredConstruction" },
    "packedRegionAuthoredProvenance": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionAuthoredProvenance" },
    "packedRegionAuthoredReconstruction": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionAuthoredReconstruction" },
    "packedRegionAuthoredReconstructionCohort": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionAuthoredReconstructionCohort" },
    "packedRegionAuthoredReconstructionCohortAttribution": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionAuthoredReconstructionCohortAttribution" },
    "packedRegionAuthoredReconstructionTopology": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionAuthoredReconstructionTopology" },
    "packedRegionAuthoredReconstructionDependencySemantics": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionAuthoredReconstructionDependencySemantics" },
    "packedRegionActiveNpcResidency": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionActiveNpcResidency" },
    "packedRegionActiveNpcContainment": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionActiveNpcContainment" },
    "packedRegionActiveNpcBoundaryRequirements": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionActiveNpcBoundaryRequirements" },
    "packedRegionRetirementRefinement": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionRetirementRefinement" },
    "packedRegionRetirementRefinementReassessment": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionRetirementRefinementReassessment" },
    "packedRegionPreservationBurden": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionPreservationBurden" },
    "packedRegionDynamicObjectPreservation": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionDynamicObjectPreservation" },
    "packedRegionEventOwnership": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionEventOwnership" },
    "packedRegionNpcOwnerEventContinuity": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionNpcOwnerEventContinuity" },
    "packedRegionNpcOwnerPreservationBoundary": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionNpcOwnerPreservationBoundary" },
    "packedRegionNpcOwnerPreservationNoOp": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/npcOwnerPreservationNoOp" }
      ]
    },
    "packedRegionEventTargets": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionEventTargets" },
    "packedRegionEventAtomicTargetRevalidation": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionEventAtomicTargetRevalidation" },
    "packedRegionEventRecoveryNoOp": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/packedRegionEventRecoveryNoOp" },
    "roundTripExact": { "$ref": "layered-map-parity-event-v50.schema.json#/properties/roundTripExact" }
  },
  "$defs": {
    "npcOwnerPreservationNoOp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason", "generation", "requirementsObservedAtTick",
        "selectedSourceCount", "requiredEventLinkCount",
        "requiredOwnerCount", "ownerScopeEntered",
        "sourceLifecycleInvoked", "absentSourceCount",
        "reconstructedSourceCount", "preservedConsumerInvoked",
        "sourceAbsencePreflight", "sourceReloadRecipe",
        "sourceTerrainVerification",
        "preservationEstablishedForConsumedWork", "preservationPerformed",
        "sourceAbsencePerformed", "sourceReconstructionPerformed",
        "regionMutationPerformed", "runtimeHandleRetained", "arrivalGate",
        "visibilityReleased", "lifecycleAuthority"
      ],
      "properties": {
        "reason": {
          "enum": ["OWNER_SCOPE_REFUSED", "SOURCE_LIFECYCLE_UNAVAILABLE"]
        },
        "generation": { "type": "integer", "minimum": 0 },
        "requirementsObservedAtTick": { "type": "integer", "minimum": 0 },
        "selectedSourceCount": {
          "type": "integer", "minimum": 0, "maximum": 128
        },
        "requiredEventLinkCount": {
          "type": "integer", "minimum": 0, "maximum": 65536
        },
        "requiredOwnerCount": {
          "type": "integer", "minimum": 0, "maximum": 65536
        },
        "ownerScopeEntered": { "type": "boolean" },
        "sourceLifecycleInvoked": { "type": "boolean" },
        "absentSourceCount": { "const": 0 },
        "reconstructedSourceCount": { "const": 0 },
        "preservedConsumerInvoked": { "const": false },
        "sourceAbsencePreflight": {
          "oneOf": [
            { "type": "null" },
            {
              "$ref": "layered-map-parity-event-v49.schema.json#/$defs/sourceAbsencePreflight"
            }
          ]
        },
        "sourceReloadRecipe": {
          "oneOf": [
            { "type": "null" },
            {
              "$ref": "layered-map-parity-event-v50.schema.json#/$defs/sourceReloadRecipe"
            }
          ]
        },
        "sourceTerrainVerification": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sourceTerrainVerification" }
          ]
        },
        "preservationEstablishedForConsumedWork": { "const": false },
        "preservationPerformed": { "const": false },
        "sourceAbsencePerformed": { "const": false },
        "sourceReconstructionPerformed": { "const": false },
        "regionMutationPerformed": { "const": false },
        "runtimeHandleRetained": { "const": false },
        "arrivalGate": { "const": false },
        "visibilityReleased": { "const": false },
        "lifecycleAuthority": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reason": { "const": "OWNER_SCOPE_REFUSED" } },
            "required": ["reason"]
          },
          "then": {
            "properties": {
              "ownerScopeEntered": { "const": false },
              "sourceLifecycleInvoked": { "const": false },
              "sourceAbsencePreflight": { "type": "null" },
              "sourceReloadRecipe": { "type": "null" },
              "sourceTerrainVerification": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": { "const": "SOURCE_LIFECYCLE_UNAVAILABLE" }
            },
            "required": ["reason"]
          },
          "then": {
            "properties": {
              "ownerScopeEntered": { "const": true },
              "sourceLifecycleInvoked": { "const": true },
              "sourceAbsencePreflight": {
                "$ref": "layered-map-parity-event-v49.schema.json#/$defs/sourceAbsencePreflight"
              },
              "sourceReloadRecipe": {
                "$ref": "layered-map-parity-event-v50.schema.json#/$defs/sourceReloadRecipe"
              },
              "sourceTerrainVerification": {
                "$ref": "#/$defs/sourceTerrainVerification"
              }
            }
          }
        }
      ]
    },
    "sourceTerrainVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation", "requirementsObservedAtTick", "observedAtTick",
        "residencyMirrorVersion", "authoredGeneration", "sourceCount",
        "verifiedTileCount", "terrainBlockedTileCount",
        "terrainCollisionMaskTileCount",
        "terrainProjectileBlockedTileCount",
        "sealedBaseTraversalTileCount",
        "disposableRegionConstructionCount",
        "disposableTerrainApplyCount", "usableRegionContainerCount",
        "pointInTimeOnly", "detachedSummaryOnly", "allSourcesVerified",
        "runtimeHandleRetained", "sourceAbsencePerformed",
        "sourceReconstructionPerformed",
        "terrainAppliedToRuntimeSource", "authoredReplayPerformed",
        "dynamicCollisionRebuildPerformed",
        "activeFamilyPreservationPerformed", "regionRegistryMutated",
        "residencyMirrorMutated", "visibilityCacheMutated",
        "arrivalGate", "visibilityReleased", "lifecycleAuthority",
        "sources"
      ],
      "properties": {
        "generation": { "type": "integer", "minimum": 0 },
        "requirementsObservedAtTick": { "type": "integer", "minimum": 0 },
        "observedAtTick": { "type": "integer", "minimum": 0 },
        "residencyMirrorVersion": { "type": "integer", "minimum": 0 },
        "authoredGeneration": { "type": "integer", "minimum": 0 },
        "sourceCount": {
          "type": "integer", "minimum": 1, "maximum": 128
        },
        "verifiedTileCount": {
          "type": "integer", "minimum": 2304, "maximum": 294912
        },
        "terrainBlockedTileCount": {
          "type": "integer", "minimum": 0, "maximum": 294912
        },
        "terrainCollisionMaskTileCount": {
          "type": "integer", "minimum": 0, "maximum": 294912
        },
        "terrainProjectileBlockedTileCount": {
          "type": "integer", "minimum": 0, "maximum": 294912
        },
        "sealedBaseTraversalTileCount": {
          "type": "integer", "minimum": 0, "maximum": 294912
        },
        "disposableRegionConstructionCount": {
          "type": "integer", "minimum": 1, "maximum": 128
        },
        "disposableTerrainApplyCount": {
          "type": "integer", "minimum": 1, "maximum": 128
        },
        "usableRegionContainerCount": { "const": 0 },
        "pointInTimeOnly": { "const": true },
        "detachedSummaryOnly": { "const": true },
        "allSourcesVerified": { "const": true },
        "runtimeHandleRetained": { "const": false },
        "sourceAbsencePerformed": { "const": false },
        "sourceReconstructionPerformed": { "const": false },
        "terrainAppliedToRuntimeSource": { "const": false },
        "authoredReplayPerformed": { "const": false },
        "dynamicCollisionRebuildPerformed": { "const": false },
        "activeFamilyPreservationPerformed": { "const": false },
        "regionRegistryMutated": { "const": false },
        "residencyMirrorMutated": { "const": false },
        "visibilityCacheMutated": { "const": false },
        "arrivalGate": { "const": false },
        "visibilityReleased": { "const": false },
        "lifecycleAuthority": { "const": false },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/sourceTerrainVerificationSource" }
        }
      }
    },
    "sourceTerrainVerificationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceOrdinal", "packedRegionX", "packedRegionY",
        "verifiedTileCount", "terrainBlockedTileCount",
        "terrainCollisionMaskTileCount",
        "terrainProjectileBlockedTileCount",
        "sealedBaseTraversalTileCount", "terrainFingerprintSha256"
      ],
      "properties": {
        "sourceOrdinal": {
          "type": "integer", "minimum": 0, "maximum": 127
        },
        "packedRegionX": { "type": "integer", "minimum": 0 },
        "packedRegionY": { "type": "integer", "minimum": 0 },
        "verifiedTileCount": { "const": 2304 },
        "terrainBlockedTileCount": {
          "type": "integer", "minimum": 0, "maximum": 2304
        },
        "terrainCollisionMaskTileCount": {
          "type": "integer", "minimum": 0, "maximum": 2304
        },
        "terrainProjectileBlockedTileCount": {
          "type": "integer", "minimum": 0, "maximum": 2304
        },
        "sealedBaseTraversalTileCount": {
          "type": "integer", "minimum": 0, "maximum": 2304
        },
        "terrainFingerprintSha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
