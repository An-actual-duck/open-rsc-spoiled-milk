{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v26.schema.json",
  "title": "Layered Map Parity Event v26",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "packedRegionRetirementSafety",
    "packedRegionAuthoredConstruction", "packedRegionAuthoredProvenance",
    "packedRegionAuthoredReconstruction",
    "packedRegionAuthoredReconstructionCohort",
    "packedRegionAuthoredReconstructionCohortAttribution",
    "packedRegionAuthoredReconstructionTopology",
    "packedRegionAuthoredReconstructionDependencySemantics",
    "packedRegionActiveNpcResidency", "packedRegionActiveNpcContainment",
    "roundTripExact"
  ],
  "properties": {
    "schema": {"const": "layered-map-parity-event-v26"},
    "eventType": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/eventType"},
    "sequence": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/sequence"},
    "timestampEpochMillis": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/timestampEpochMillis"},
    "player": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/player"},
    "label": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/label"},
    "teleported": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/teleported"},
    "from": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/from"},
    "to": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/to"},
    "delta": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/delta"},
    "interestDelta": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/interestDelta"},
    "packedCoverage": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedCoverage"},
    "tileSnapshot": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/tileSnapshot"},
    "tileParity": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/tileParity"},
    "tileNeighborhood": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/tileNeighborhood"},
    "adjacentCollision": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/adjacentCollision"},
    "recentTraversal": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/recentTraversal"},
    "regionResidency": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/regionResidency"},
    "interestOwnership": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/interestOwnership"},
    "regionRetirement": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/regionRetirement"},
    "regionRetirementDecisions": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/regionRetirementDecisions"},
    "packedRegionRetirementReadiness": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionRetirementReadiness"},
    "packedRegionRetirementSafety": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionRetirementSafety"},
    "packedRegionAuthoredConstruction": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionAuthoredConstruction"},
    "packedRegionAuthoredProvenance": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionAuthoredProvenance"},
    "packedRegionAuthoredReconstruction": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionAuthoredReconstruction"},
    "packedRegionAuthoredReconstructionCohort": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionAuthoredReconstructionCohort"},
    "packedRegionAuthoredReconstructionCohortAttribution": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionAuthoredReconstructionCohortAttribution"},
    "packedRegionAuthoredReconstructionTopology": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionAuthoredReconstructionTopology"},
    "packedRegionAuthoredReconstructionDependencySemantics": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionAuthoredReconstructionDependencySemantics"},
    "packedRegionActiveNpcResidency": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/packedRegionActiveNpcResidency"},
    "packedRegionActiveNpcContainment": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/activeNpcContainmentAssessment"}
      ]
    },
    "roundTripExact": {"$ref": "layered-map-parity-event-v25.schema.json#/properties/roundTripExact"}
  },
  "allOf": [
    {
      "if": {"properties": {"packedRegionActiveNpcResidency": {"type": "null"}}},
      "then": {"properties": {"packedRegionActiveNpcContainment": {"type": "null"}}}
    }
  ],
  "$defs": {
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "boundedCount": {"type": "integer", "minimum": 0, "maximum": 8192},
    "blockerKind": {
      "enum": [
        "SELECTED_OWNER_OUTSIDE", "EXTERNAL_OWNER_INSIDE",
        "UNRESOLVED_INSIDE",
        "UNRESOLVED_CLAIMED_SELECTED_OWNER_OUTSIDE",
        "RELEVANT_INACTIVE", "RELEVANT_DUPLICATE_IDENTITY"
      ]
    },
    "blockerCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instanceCount"],
      "properties": {
        "kind": {"$ref": "#/$defs/blockerKind"},
        "instanceCount": {"$ref": "#/$defs/boundedCount"}
      }
    },
    "activeNpcContainmentAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation", "safetyObservedAtTick", "censusObservedAtTick",
        "selectedSourceCount", "activeInstanceCount",
        "relevantActiveInstanceCount", "selectedOwnerInsideCount",
        "sameSourceSelectedOwnerInsideCount",
        "crossSourceSelectedOwnerInsideCount", "currentInsideCount",
        "activePreservationRequiredInstanceCount",
        "relevantDuplicateIdentityInstanceCount", "blockingConditionCount",
        "blockingEvidenceCount", "boundaryContained", "pointInTimeOnly",
        "containmentEvidence", "entityPreservationRequired",
        "lifecycleReady", "entityRegistry", "arrivalGate",
        "lifecycleAuthority", "blockers"
      ],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "safetyObservedAtTick": {"$ref": "#/$defs/nonNegativeInteger"},
        "censusObservedAtTick": {"$ref": "#/$defs/nonNegativeInteger"},
        "selectedSourceCount": {"$ref": "#/$defs/boundedCount"},
        "activeInstanceCount": {"$ref": "#/$defs/boundedCount"},
        "relevantActiveInstanceCount": {"$ref": "#/$defs/boundedCount"},
        "selectedOwnerInsideCount": {"$ref": "#/$defs/boundedCount"},
        "sameSourceSelectedOwnerInsideCount": {"$ref": "#/$defs/boundedCount"},
        "crossSourceSelectedOwnerInsideCount": {"$ref": "#/$defs/boundedCount"},
        "currentInsideCount": {"$ref": "#/$defs/boundedCount"},
        "activePreservationRequiredInstanceCount": {"$ref": "#/$defs/boundedCount"},
        "relevantDuplicateIdentityInstanceCount": {"$ref": "#/$defs/boundedCount"},
        "blockingConditionCount": {"type": "integer", "minimum": 0, "maximum": 6},
        "blockingEvidenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "boundaryContained": {"type": "boolean"},
        "pointInTimeOnly": {"const": true},
        "containmentEvidence": {"const": true},
        "entityPreservationRequired": {"type": "boolean"},
        "lifecycleReady": {"const": false},
        "entityRegistry": {"const": false},
        "arrivalGate": {"const": false},
        "lifecycleAuthority": {"const": false},
        "blockers": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {"$ref": "#/$defs/blockerCount"}
        }
      }
    }
  }
}
