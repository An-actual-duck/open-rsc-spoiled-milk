{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsc-remastered.invalid/schema/rle-layered-sector-v1.schema.json",
  "title": "Run-Length Encoded Layered Terrain Sector v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "encoding", "size", "tileOrder", "runs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "encoding": {"const": "rle-layered-sector-v1"},
    "size": {"const": 48},
    "tileOrder": {"const": "x-major-y-minor"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2304,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count", "tile"],
        "properties": {
          "count": {"type": "integer", "minimum": 1, "maximum": 2304},
          "tile": {"$ref": "#/$defs/tile"}
        }
      }
    }
  },
  "$defs": {
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elevation",
        "texture",
        "overlay",
        "roof",
        "verticalWall",
        "horizontalWall",
        "diagonalWall"
      ],
      "properties": {
        "elevation": {"type": "integer", "minimum": 0, "maximum": 255},
        "texture": {"type": "integer", "minimum": 0, "maximum": 255},
        "overlay": {"type": "integer", "minimum": 0, "maximum": 255},
        "roof": {"type": "integer", "minimum": 0, "maximum": 255},
        "verticalWall": {"type": "integer", "minimum": 0, "maximum": 255},
        "horizontalWall": {"type": "integer", "minimum": 0, "maximum": 255},
        "diagonalWall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    }
  }
}
