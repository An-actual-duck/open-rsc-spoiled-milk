              "generationBindingComplete": {
                "const": false
              },
              "scenery": {
                "properties": {
                  "authoredPlacement": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generationBindingComplete": {
                "const": true
              }
