  "$defs": {
    "recoveryNoOp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "preparationReason",
        "lifecycleReason",
        "proposalGeneration",
        "inventoryEventCount",
        "recoveryCandidateCount",
        "proposalRelatedEventCount",
        "recoveryCompleteEventCount",
        "recoveryIncompleteEventCount",
        "incompleteOwnerPositionHintEventCount",
        "incompleteExactSpatialEventCount",
        "firstIncompleteRegistrationSequence",
        "firstIncompleteOwnerKind",
        "firstIncompleteAttributionKind",
        "firstIncompleteRecoveryRequirement",
        "preflightComplete",
        "futureSnapshotCount",
        "runtimeVerificationCount",
        "mutationOperationCount",
        "terminalEventConsumptionCount",
        "reconstructionInvoked",
        "recoveryInvoked",
        "contractuallyReadyForFirstVisibility",
        "freshInventoryRetryRequired",
        "verificationOnly",
        "noOpReconstruction",
        "regionMutationAllowed",
        "overdueConsumptionAllowed",
        "regionLoadingPerformed",
        "retryPerformed",
        "arrivalGate",
        "visibilityReleased",
        "runtimeHandleRetained"
      ],
      "properties": {
        "reason": {
          "enum": [
            "LIVE_CAPTURE_REFUSED",
            "NO_RECOVERY_CANDIDATES",
            "NON_FUTURE_CANDIDATE_REFUSED",
            "VERIFICATION_REFUSED",
            "NO_OP_VERIFICATION_READY"
          ]
        },
        "preparationReason": {
          "enum": [
            "READY_BEFORE_RECONSTRUCTION",
            "CANDIDATE_BOUND_EXCEEDED",
            "RELATED_EVENT_RECOVERY_INCOMPLETE",
            "REGISTRATION_SET_DRIFT",
            "SCHEDULER_CAPTURE_REFUSED",
            "FUTURE_CURRENT_STATE_CAPTURE_REFUSED",
            "REGISTRATION_OR_TIMING_DRIFT",
            "PREPARATION_CONTRACT_REFUSED"
          ]
        },
        "lifecycleReason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "CAPTURE_REFUSED",
                "CAPTURE_ALREADY_CONSUMED",
                "RECONSTRUCTION_CORRELATION_REFUSED",
                "RECONSTRUCTION_REFUSED",
                "RECOVERY_REFUSED_REQUIRES_FRESH_INVENTORY",
                "RECOVERY_EXECUTION_INVALID",
                "CONTRACTUALLY_READY_FOR_FIRST_VISIBILITY"
              ]
            }
          ]
        },
        "proposalGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "inventoryEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryCandidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "proposalRelatedEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryCompleteEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryIncompleteEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "incompleteOwnerPositionHintEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "incompleteExactSpatialEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "firstIncompleteRegistrationSequence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "firstIncompleteOwnerKind": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "NONE",
                "PLAYER",
                "NPC"
              ]
            }
          ]
        },
        "firstIncompleteAttributionKind": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "EXACT_SPATIAL",
                "OWNER_POSITION_HINT",
                "NON_SPATIAL_GLOBAL",
                "UNATTRIBUTED"
              ]
            }
          ]
        },
        "firstIncompleteRecoveryRequirement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "RESTORATION_STATE_UNAVAILABLE",
                "ATOMIC_TIMING_UNAVAILABLE",
                "EVENT_NOT_RUNNING",
                "EVENT_ALREADY_EXECUTED",
                "DETACHED_PAYLOAD_INCOMPLETE",
                "EXECUTION_SEMANTICS_INCOMPLETE",
                "TARGET_BINDING_REQUIREMENT_INCOMPLETE",
                "TARGET_BINDING_INCOMPLETE",
                "ARRIVAL_ORDERING_INCOMPLETE",
                "GENERATION_BINDING_REQUIREMENT_INCOMPLETE",
                "GENERATION_BINDING_MISMATCH",
                "IDEMPOTENCY_REQUIREMENT_INCOMPLETE"
              ]
            }
          ]
        },
        "preflightComplete": {
          "type": "boolean"
        },
        "futureSnapshotCount": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeVerificationCount": {
          "type": "integer",
          "minimum": 0
        },
        "mutationOperationCount": {
          "const": 0
        },
        "terminalEventConsumptionCount": {
          "const": 0
        },
        "reconstructionInvoked": {
          "type": "boolean"
        },
        "recoveryInvoked": {
          "type": "boolean"
        },
        "contractuallyReadyForFirstVisibility": {
          "type": "boolean"
        },
        "freshInventoryRetryRequired": {
          "type": "boolean"
        },
        "verificationOnly": {
          "const": true
        },
        "noOpReconstruction": {
          "const": true
        },
        "regionMutationAllowed": {
          "const": false
        },
        "overdueConsumptionAllowed": {
          "const": false
        },
        "regionLoadingPerformed": {
          "const": false
        },
        "retryPerformed": {
          "const": false
        },
        "arrivalGate": {
          "const": false
        },
        "visibilityReleased": {
          "const": false
        },
        "runtimeHandleRetained": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "preflightComplete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "recoveryIncompleteEventCount": {
                "const": 0
              },
              "firstIncompleteRegistrationSequence": {
                "type": "null"
              },
              "firstIncompleteOwnerKind": {
                "type": "null"
              },
              "firstIncompleteAttributionKind": {
                "type": "null"
              },
              "firstIncompleteRecoveryRequirement": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "recoveryIncompleteEventCount": {
                "type": "integer",
                "minimum": 1
              },
              "firstIncompleteRegistrationSequence": {
                "type": "integer",
                "minimum": 1
              },
              "firstIncompleteOwnerKind": {
                "type": "string"
              },
              "firstIncompleteAttributionKind": {
                "type": "string"
              },
              "firstIncompleteRecoveryRequirement": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "preparationReason": {
                "const": "RELATED_EVENT_RECOVERY_INCOMPLETE"
              }
            }
          },
          "then": {
            "properties": {
              "preflightComplete": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "NO_OP_VERIFICATION_READY"
              }
            }
          },
          "then": {
            "properties": {
              "lifecycleReason": {
                "const": "CONTRACTUALLY_READY_FOR_FIRST_VISIBILITY"
              },
              "preflightComplete": {
                "const": true
              },
              "reconstructionInvoked": {
                "const": true
              },
              "recoveryInvoked": {
                "const": true
              },
              "contractuallyReadyForFirstVisibility": {
                "const": true
              },
              "freshInventoryRetryRequired": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "contractuallyReadyForFirstVisibility": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "enum": [
                  "LIVE_CAPTURE_REFUSED",
                  "NO_RECOVERY_CANDIDATES",
                  "NON_FUTURE_CANDIDATE_REFUSED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "lifecycleReason": {
                "type": "null"
              },
              "reconstructionInvoked": {
                "const": false
              },
              "recoveryInvoked": {
                "const": false
              },
              "runtimeVerificationCount": {
                "const": 0
              },
              "freshInventoryRetryRequired": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recoveryInvoked": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "reconstructionInvoked": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "NO_RECOVERY_CANDIDATES"
              }
            }
          },
          "then": {
            "properties": {
              "recoveryCandidateCount": {
                "const": 0
              },
              "recoveryCompleteEventCount": {
                "const": 0
              },
              "futureSnapshotCount": {
                "const": 0
              }
            }
          }
        }
      ]
    },
