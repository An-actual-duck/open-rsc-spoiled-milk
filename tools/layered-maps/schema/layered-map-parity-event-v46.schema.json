                "const": "AUTHORED_SCENERY_ABSENT"
              },
              "mutationPrecondition": {
                "const": "EXACT_AUTHORED_ENTITY_PRESENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "bindingEvidence": {
                "const": "AUTHORED_PLACEMENT_IDENTITY"
              }
            }
          },
          "then": {
            "properties": {
              "targetBindingComplete": {
                "const": true
