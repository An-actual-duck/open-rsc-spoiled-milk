        "outerOutcomeCountComplete", "acceptedContractOutcomeCountComplete",
        "pointInTimeOnly", "atomicWithEventInventory",
        "runtimeTargetLookupPerformed", "runtimeRevalidationPerformed",
        "atomicWithMutation", "entityHandleRetained", "achievedStateClaimed",
        "commitToken", "mutationPerformed", "executableRestoration",
        "arrivalGate", "lifecycleAuthority", "records"
      ],
      "properties": {
        "proposalGeneration": {"type": "integer", "minimum": 1},
        "eventInventoryObservedAtTick": {"type": "integer", "minimum": 0},
        "revalidationObservedAtTick": {"type": "integer", "minimum": 0},
        "schedulerInstanceIdentity": {"type": "string", "minLength": 1},
        "recordCount": {"type": "integer", "minimum": 0, "maximum": 65536},
        "outerFenceAcceptedCount": {"type": "integer", "minimum": 0, "maximum": 65536},
        "outerFenceRefusedCount": {"type": "integer", "minimum": 0, "maximum": 65536},
        "lifecycleChangeDetectedCount": {"type": "integer", "minimum": 0, "maximum": 65536},
        "runtimeTargetLookupPerformedCount": {"type": "integer", "minimum": 0, "maximum": 65536},
        "runtimeRevalidationPerformedCount": {"type": "integer", "minimum": 0, "maximum": 65536},
        "contractRefusedCount": {"type": "integer", "minimum": 0, "maximum": 65536},
        "noOpContractSatisfiedCount": {"type": "integer", "minimum": 0, "maximum": 65536},
        "mutationPreconditionContractSatisfiedCount": {"type": "integer", "minimum": 0, "maximum": 65536},
        "outerOutcomeCountComplete": {"const": true},
        "acceptedContractOutcomeCountComplete": {"const": true},
        "pointInTimeOnly": {"const": true},
        "atomicWithEventInventory": {"const": false},
        "runtimeTargetLookupPerformed": {"type": "boolean"},
        "runtimeRevalidationPerformed": {"type": "boolean"},
        "atomicWithMutation": {"const": false},
        "entityHandleRetained": {"const": false},
        "achievedStateClaimed": {"const": false},
        "commitToken": {"const": false},
        "mutationPerformed": {"const": false},
        "executableRestoration": {"const": false},
        "arrivalGate": {"const": false},
        "lifecycleAuthority": {"const": false},
        "records": {
          "type": "array",
          "maxItems": 65536,
          "items": {"$ref": "#/$defs/atomicTargetRevalidationRecord"}
        }
      }
    },
    "atomicTargetRevalidationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotOrdinal", "registrationSequence", "packedX", "packedY",
        "outerFenceReason", "outerFenceAccepted", "operationInvoked",
        "lifecycleVersionBeforeOperation", "lifecycleVersionAfterOperation",
        "timingStableAcrossOperation", "lifecycleChangeDetected",
        "runtimeTargetLookupPerformed", "runtimeRevalidationPerformed",
        "target"
      ],
      "properties": {
        "snapshotOrdinal": {"type": "integer", "minimum": 0, "maximum": 65535},
        "registrationSequence": {"type": "integer", "minimum": 1},
        "packedX": {"type": "integer", "minimum": 0},
        "packedY": {"type": "integer", "minimum": 0},
        "outerFenceReason": {"enum": [
          "SCHEDULER_INSTANCE_MISMATCH", "EVENT_NOT_REGISTERED",
          "DUPLICATE_REGISTRATION_SEQUENCE", "REGISTRATION_SEQUENCE_MISMATCH",
          "RESTORATION_STATE_UNAVAILABLE", "EVENT_NOT_RUNNING",
          "EVENT_ALREADY_EXECUTED", "RESTORATION_PAYLOAD_INCOMPLETE",
          "AUTHORED_IDENTITY_MISSING", "OWNER_BOUND_STATE_REFUSED",
          "RUNTIME_ATTRIBUTE_STATE_INCOMPLETE",
          "AUTHORED_CONSTRUCTION_KIND_MISMATCH", "SPATIAL_AFFINITY_MISMATCH",
          "PROPOSAL_GENERATION_MISMATCH",
          "EVENT_LIFECYCLE_CHANGED_DURING_OPERATION", "OPERATION_COMPLETED"
        ]},
        "outerFenceAccepted": {"type": "boolean"},
        "operationInvoked": {"type": "boolean"},
        "lifecycleVersionBeforeOperation": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
        },
        "lifecycleVersionAfterOperation": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
        },
        "timingStableAcrossOperation": {"type": "boolean"},
        "lifecycleChangeDetected": {"type": "boolean"},
        "runtimeTargetLookupPerformed": {"type": "boolean"},
        "runtimeRevalidationPerformed": {"type": "boolean"},
        "target": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/atomicTargetRevalidationTarget"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"outerFenceAccepted": {"const": true}}},
          "then": {"properties": {
            "outerFenceReason": {"const": "OPERATION_COMPLETED"},
            "operationInvoked": {"const": true},
            "lifecycleVersionBeforeOperation": {"type": "integer", "minimum": 1},
            "lifecycleVersionAfterOperation": {"type": "integer", "minimum": 1},
            "timingStableAcrossOperation": {"const": true},
            "runtimeTargetLookupPerformed": {"const": true},
            "target": {"$ref": "#/$defs/atomicTargetRevalidationTarget"}
          }},
          "else": {"properties": {
            "timingStableAcrossOperation": {"const": false},
            "target": {"type": "null"}
          }}
        },
        {
          "if": {"properties": {"operationInvoked": {"const": false}}},
          "then": {"properties": {
            "lifecycleVersionBeforeOperation": {"type": "null"},
            "lifecycleVersionAfterOperation": {"type": "null"},
            "runtimeTargetLookupPerformed": {"const": false},
            "runtimeRevalidationPerformed": {"const": false}
          }}
        },
        {
          "if": {"properties": {"lifecycleChangeDetected": {"const": true}}},
          "then": {"properties": {
            "outerFenceReason": {"const": "EVENT_LIFECYCLE_CHANGED_DURING_OPERATION"},
            "outerFenceAccepted": {"const": false},
            "operationInvoked": {"const": true},
            "runtimeTargetLookupPerformed": {"const": true},
            "runtimeRevalidationPerformed": {"const": false},
            "target": {"type": "null"}
          }}
        }
      ]
    },
    "atomicTargetRevalidationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionAvailable", "slotObjectCount",
        "exactRestorationSceneryCount", "exactAuthoredIdentityCount",
        "objectBoundaryHeldDuringClassification", "observedTargetState",
        "targetOutcome", "targetReason", "contractOutcome", "contractReason"
      ],
      "properties": {
        "regionAvailable": {"type": "boolean"},
        "slotObjectCount": {"type": "integer", "minimum": 0},
        "exactRestorationSceneryCount": {"type": "integer", "minimum": 0},
        "exactAuthoredIdentityCount": {"type": "integer", "minimum": 0},
        "objectBoundaryHeldDuringClassification": {"type": "boolean"},
        "observedTargetState": {"enum": [
          "UNAVAILABLE", "EMPTY", "EXACT_RESTORATION_SCENERY_PRESENT",
