          "MISMATCHED_OR_IDENTITYLESS_OCCUPANT", "AMBIGUOUS_OCCUPANCY"
        ]},
        "targetOutcome": {"enum": [
          "REFUSED", "NO_OP_SUCCESS", "MUTATION_PRECONDITION_SATISFIED"
