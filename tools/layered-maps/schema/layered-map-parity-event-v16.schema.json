{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v16.schema.json",
  "title": "Layered Map Parity Event v16",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "packedRegionRetirementSafety",
    "packedRegionAuthoredConstruction", "roundTripExact"
  ],
  "properties": {
    "schema": {"const": "layered-map-parity-event-v16"},
    "eventType": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/eventType"
    },
    "sequence": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/sequence"
    },
    "timestampEpochMillis": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/timestampEpochMillis"
    },
    "player": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/player"
    },
    "label": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/label"
    },
    "teleported": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/teleported"
    },
    "from": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/from"
    },
    "to": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/to"
    },
    "delta": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/delta"
    },
    "interestDelta": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/interestDelta"
    },
    "packedCoverage": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/packedCoverage"
    },
    "tileSnapshot": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/tileSnapshot"
    },
    "tileParity": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/tileParity"
    },
    "tileNeighborhood": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/tileNeighborhood"
    },
    "adjacentCollision": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/adjacentCollision"
    },
    "recentTraversal": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/recentTraversal"
    },
    "regionResidency": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/regionResidency"
    },
    "interestOwnership": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/interestOwnership"
    },
    "regionRetirement": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/regionRetirement"
    },
    "regionRetirementDecisions": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/regionRetirementDecisions"
    },
    "packedRegionRetirementReadiness": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/packedRegionRetirementReadiness"
    },
    "packedRegionRetirementSafety": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/packedRegionRetirementSafety"
    },
    "packedRegionAuthoredConstruction": {
      "oneOf": [
        {"$ref": "#/$defs/packedRegionAuthoredConstruction"},
        {"type": "null"}
      ]
    },
    "roundTripExact": {
      "$ref": "layered-map-parity-event-v15.schema.json#/properties/roundTripExact"
    }
  },
  "allOf": [
    {"$ref": "layered-map-parity-event-v15.schema.json#/allOf/0"},
    {"$ref": "layered-map-parity-event-v15.schema.json#/allOf/1"},
    {"$ref": "layered-map-parity-event-v15.schema.json#/allOf/2"},
    {"$ref": "layered-map-parity-event-v15.schema.json#/allOf/3"},
    {"$ref": "layered-map-parity-event-v15.schema.json#/allOf/4"},
    {
      "if": {"properties": {"packedRegionRetirementSafety": {"type": "null"}}},
      "then": {
        "properties": {"packedRegionAuthoredConstruction": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "packedRegionAuthoredConstructionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packedRegionX", "packedRegionY", "sceneryCount", "boundaryCount",
        "npcSpawnCount", "groundItemSpawnCount", "harvestingSceneryCount",
        "authoredConstructionCount"
      ],
      "properties": {
        "packedRegionX": {"type": "integer", "minimum": 0},
        "packedRegionY": {"type": "integer", "minimum": 0},
        "sceneryCount": {"type": "integer", "minimum": 0},
        "boundaryCount": {"type": "integer", "minimum": 0},
        "npcSpawnCount": {"type": "integer", "minimum": 0},
        "groundItemSpawnCount": {"type": "integer", "minimum": 0},
        "harvestingSceneryCount": {"type": "integer", "minimum": 0},
        "authoredConstructionCount": {"type": "integer", "minimum": 0}
      }
    },
    "packedRegionAuthoredConstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation", "safetyObservedAtTick", "readinessObservedAtTick",
        "inventorySourceCount", "inventorySceneryCount",
        "inventoryBoundaryCount", "inventoryNpcSpawnCount",
        "inventoryGroundItemSpawnCount", "inventoryHarvestingSceneryCount",
        "inventoryAuthoredConstructionCount", "sourceCount",
        "authoredSourceCount", "sceneryCount", "boundaryCount",
        "npcSpawnCount", "groundItemSpawnCount", "harvestingSceneryCount",
        "authoredConstructionCount", "originCountsOnly",
        "reconstructionManifest", "entries"
      ],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "safetyObservedAtTick": {"type": "integer", "minimum": 0},
        "readinessObservedAtTick": {"type": "integer", "minimum": -1},
        "inventorySourceCount": {
          "type": "integer", "minimum": 0, "maximum": 8192
        },
        "inventorySceneryCount": {"type": "integer", "minimum": 0},
        "inventoryBoundaryCount": {"type": "integer", "minimum": 0},
        "inventoryNpcSpawnCount": {"type": "integer", "minimum": 0},
        "inventoryGroundItemSpawnCount": {"type": "integer", "minimum": 0},
        "inventoryHarvestingSceneryCount": {"type": "integer", "minimum": 0},
        "inventoryAuthoredConstructionCount": {"type": "integer", "minimum": 0},
        "sourceCount": {
          "type": "integer", "minimum": 0, "maximum": 8192
        },
        "authoredSourceCount": {
          "type": "integer", "minimum": 0, "maximum": 8192
        },
        "sceneryCount": {"type": "integer", "minimum": 0},
        "boundaryCount": {"type": "integer", "minimum": 0},
        "npcSpawnCount": {"type": "integer", "minimum": 0},
        "groundItemSpawnCount": {"type": "integer", "minimum": 0},
        "harvestingSceneryCount": {"type": "integer", "minimum": 0},
        "authoredConstructionCount": {"type": "integer", "minimum": 0},
        "originCountsOnly": {"const": true},
        "reconstructionManifest": {"const": false},
        "entries": {
          "type": "array",
          "maxItems": 8192,
          "items": {"$ref": "#/$defs/packedRegionAuthoredConstructionEntry"}
        }
      }
    }
  }
}
