{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v49.schema.json",
  "title": "Layered Map Parity Event v49",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "packedRegionRetirementSafety",
    "packedRegionAuthoredConstruction", "packedRegionAuthoredProvenance",
    "packedRegionAuthoredReconstruction",
    "packedRegionAuthoredReconstructionCohort",
    "packedRegionAuthoredReconstructionCohortAttribution",
    "packedRegionAuthoredReconstructionTopology",
    "packedRegionAuthoredReconstructionDependencySemantics",
    "packedRegionActiveNpcResidency", "packedRegionActiveNpcContainment",
    "packedRegionActiveNpcBoundaryRequirements",
    "packedRegionRetirementRefinement",
    "packedRegionRetirementRefinementReassessment",
    "packedRegionPreservationBurden",
    "packedRegionDynamicObjectPreservation", "packedRegionEventOwnership",
    "packedRegionNpcOwnerEventContinuity",
    "packedRegionNpcOwnerPreservationBoundary",
    "packedRegionNpcOwnerPreservationNoOp", "packedRegionEventTargets",
    "packedRegionEventAtomicTargetRevalidation",
    "packedRegionEventRecoveryNoOp", "roundTripExact"
  ],
  "properties": {
    "schema": { "const": "layered-map-parity-event-v49" },
    "eventType": {
      "enum": [
        "start", "snapshot", "marker", "move", "teleport", "login",
        "logout", "stop", "recovery-noop", "preservation-noop"
      ]
    },
    "sequence": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/sequence" },
    "timestampEpochMillis": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/timestampEpochMillis" },
    "player": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/player" },
    "label": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/label" },
    "teleported": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/teleported" },
    "from": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/from" },
    "to": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/to" },
    "delta": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/delta" },
    "interestDelta": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/interestDelta" },
    "packedCoverage": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedCoverage" },
    "tileSnapshot": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/tileSnapshot" },
    "tileParity": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/tileParity" },
    "tileNeighborhood": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/tileNeighborhood" },
    "adjacentCollision": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/adjacentCollision" },
    "recentTraversal": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/recentTraversal" },
    "regionResidency": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/regionResidency" },
    "interestOwnership": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/interestOwnership" },
    "regionRetirement": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/regionRetirement" },
    "regionRetirementDecisions": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/regionRetirementDecisions" },
    "packedRegionRetirementReadiness": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionRetirementReadiness" },
    "packedRegionRetirementSafety": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionRetirementSafety" },
    "packedRegionAuthoredConstruction": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionAuthoredConstruction" },
    "packedRegionAuthoredProvenance": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionAuthoredProvenance" },
    "packedRegionAuthoredReconstruction": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionAuthoredReconstruction" },
    "packedRegionAuthoredReconstructionCohort": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionAuthoredReconstructionCohort" },
    "packedRegionAuthoredReconstructionCohortAttribution": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionAuthoredReconstructionCohortAttribution" },
    "packedRegionAuthoredReconstructionTopology": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionAuthoredReconstructionTopology" },
    "packedRegionAuthoredReconstructionDependencySemantics": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionAuthoredReconstructionDependencySemantics" },
    "packedRegionActiveNpcResidency": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionActiveNpcResidency" },
    "packedRegionActiveNpcContainment": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionActiveNpcContainment" },
    "packedRegionActiveNpcBoundaryRequirements": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionActiveNpcBoundaryRequirements" },
    "packedRegionRetirementRefinement": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionRetirementRefinement" },
    "packedRegionRetirementRefinementReassessment": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionRetirementRefinementReassessment" },
    "packedRegionPreservationBurden": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionPreservationBurden" },
    "packedRegionDynamicObjectPreservation": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionDynamicObjectPreservation" },
    "packedRegionEventOwnership": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionEventOwnership" },
    "packedRegionNpcOwnerEventContinuity": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionNpcOwnerEventContinuity" },
    "packedRegionNpcOwnerPreservationBoundary": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionNpcOwnerPreservationBoundary" },
    "packedRegionNpcOwnerPreservationNoOp": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/npcOwnerPreservationNoOp" }
      ]
    },
    "packedRegionEventTargets": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionEventTargets" },
    "packedRegionEventAtomicTargetRevalidation": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionEventAtomicTargetRevalidation" },
    "packedRegionEventRecoveryNoOp": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/packedRegionEventRecoveryNoOp" },
    "roundTripExact": { "$ref": "layered-map-parity-event-v48.schema.json#/properties/roundTripExact" }
  },
  "$defs": {
    "npcOwnerPreservationNoOp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason", "generation", "requirementsObservedAtTick",
        "selectedSourceCount", "requiredEventLinkCount",
        "requiredOwnerCount", "ownerScopeEntered",
        "sourceLifecycleInvoked", "absentSourceCount",
        "reconstructedSourceCount", "preservedConsumerInvoked",
        "sourceAbsencePreflight",
        "preservationEstablishedForConsumedWork", "preservationPerformed",
        "sourceAbsencePerformed", "sourceReconstructionPerformed",
        "regionMutationPerformed", "runtimeHandleRetained", "arrivalGate",
        "visibilityReleased", "lifecycleAuthority"
      ],
      "properties": {
        "reason": {
          "enum": ["OWNER_SCOPE_REFUSED", "SOURCE_LIFECYCLE_UNAVAILABLE"]
        },
        "generation": { "type": "integer", "minimum": 0 },
        "requirementsObservedAtTick": { "type": "integer", "minimum": 0 },
        "selectedSourceCount": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "requiredEventLinkCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "requiredOwnerCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "ownerScopeEntered": { "type": "boolean" },
        "sourceLifecycleInvoked": { "type": "boolean" },
        "absentSourceCount": { "const": 0 },
        "reconstructedSourceCount": { "const": 0 },
        "preservedConsumerInvoked": { "const": false },
        "sourceAbsencePreflight": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sourceAbsencePreflight" }
          ]
        },
        "preservationEstablishedForConsumedWork": { "const": false },
        "preservationPerformed": { "const": false },
        "sourceAbsencePerformed": { "const": false },
        "sourceReconstructionPerformed": { "const": false },
        "regionMutationPerformed": { "const": false },
        "runtimeHandleRetained": { "const": false },
        "arrivalGate": { "const": false },
        "visibilityReleased": { "const": false },
        "lifecycleAuthority": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reason": { "const": "OWNER_SCOPE_REFUSED" } },
            "required": ["reason"]
          },
          "then": {
            "properties": {
              "ownerScopeEntered": { "const": false },
              "sourceLifecycleInvoked": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": { "const": "SOURCE_LIFECYCLE_UNAVAILABLE" }
            },
            "required": ["reason"]
          },
          "then": {
            "properties": {
              "ownerScopeEntered": { "const": true },
              "sourceLifecycleInvoked": { "const": true },
              "sourceAbsencePreflight": {
                "$ref": "#/$defs/sourceAbsencePreflight"
              }
            }
          }
        }
      ]
    },
    "sourceAbsencePreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation", "requirementsObservedAtTick", "observedAtTick",
        "residencyMirrorVersion", "sourceCount", "readySourceCount",
        "blockedSourceCount", "absenceReadyAtObservation", "totals",
        "blockerSummaries", "pointInTimeOnly", "sourceAbsencePerformed",
        "sourceReconstructionPerformed", "runtimeHandleRetained",
        "regionRegistryMutated", "residencyMirrorMutated",
        "visibilityCacheMutated", "arrivalGate", "lifecycleAuthority",
        "sources"
      ],
      "properties": {
        "generation": { "type": "integer", "minimum": 0 },
        "requirementsObservedAtTick": {
          "type": "integer", "minimum": 0
        },
        "observedAtTick": { "type": "integer", "minimum": 0 },
        "residencyMirrorVersion": { "type": "integer", "minimum": 0 },
        "sourceCount": {
          "type": "integer", "minimum": 1, "maximum": 8192
        },
        "readySourceCount": {
          "type": "integer", "minimum": 0, "maximum": 8192
        },
        "blockedSourceCount": {
          "type": "integer", "minimum": 0, "maximum": 8192
        },
        "absenceReadyAtObservation": { "type": "boolean" },
        "totals": { "$ref": "#/$defs/sourceAbsenceTotals" },
        "blockerSummaries": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/sourceAbsenceBlockerSummary" }
        },
        "pointInTimeOnly": { "const": true },
        "sourceAbsencePerformed": { "const": false },
        "sourceReconstructionPerformed": { "const": false },
        "runtimeHandleRetained": { "const": false },
        "regionRegistryMutated": { "const": false },
        "residencyMirrorMutated": { "const": false },
        "visibilityCacheMutated": { "const": false },
        "arrivalGate": { "const": false },
        "lifecycleAuthority": { "const": false },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8192,
          "items": { "$ref": "#/$defs/sourceAbsenceSource" }
        }
      }
    },
    "sourceAbsenceTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "players", "npcs", "authoredObjects", "dynamicObjects",
        "groundItems", "collisionProductTiles"
      ],
      "properties": {
        "players": { "type": "integer", "minimum": 0 },
        "npcs": { "type": "integer", "minimum": 0 },
        "authoredObjects": { "type": "integer", "minimum": 0 },
        "dynamicObjects": { "type": "integer", "minimum": 0 },
        "groundItems": { "type": "integer", "minimum": 0 },
        "collisionProductTiles": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceAbsenceBlocker": {
      "enum": [
        "TILE_STORAGE_UNAVAILABLE",
        "ACTIVE_PLAYER_PRESENT",
        "NPC_MEMBERSHIP_PRESERVATION_UNAVAILABLE",
        "AUTHORED_OBJECT_RELOAD_UNAVAILABLE",
        "DYNAMIC_OBJECT_PRESERVATION_UNAVAILABLE",
        "GROUND_ITEM_PRESERVATION_UNAVAILABLE",
        "COLLISION_REBUILD_UNAVAILABLE",
        "REGION_RELOAD_PATH_UNAVAILABLE"
      ]
    },
    "sourceAbsenceBlockerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "blockedSourceCount"],
      "properties": {
        "blocker": { "$ref": "#/$defs/sourceAbsenceBlocker" },
        "blockedSourceCount": {
          "type": "integer", "minimum": 0, "maximum": 8192
        }
      }
    },
    "sourceAbsenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packedRegionX", "packedRegionY", "tileStorageAvailable",
        "playerCount", "npcCount", "authoredObjectCount",
        "dynamicObjectCount", "groundItemCount",
        "collisionProductTileCount", "absenceReadyAtObservation",
        "blockers"
      ],
      "properties": {
        "packedRegionX": { "type": "integer", "minimum": 0 },
        "packedRegionY": { "type": "integer", "minimum": 0 },
        "tileStorageAvailable": { "type": "boolean" },
        "playerCount": { "type": "integer", "minimum": 0 },
        "npcCount": { "type": "integer", "minimum": 0 },
        "authoredObjectCount": { "type": "integer", "minimum": 0 },
        "dynamicObjectCount": { "type": "integer", "minimum": 0 },
        "groundItemCount": { "type": "integer", "minimum": 0 },
        "collisionProductTileCount": {
          "type": "integer", "minimum": 0
        },
        "absenceReadyAtObservation": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceAbsenceBlocker" }
        }
      }
    }
  }
}
