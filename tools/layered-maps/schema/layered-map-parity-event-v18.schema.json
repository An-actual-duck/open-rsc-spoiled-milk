{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v18.schema.json",
  "title": "Layered Map Parity Event v18",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "packedRegionRetirementSafety",
    "packedRegionAuthoredConstruction", "packedRegionAuthoredProvenance",
    "roundTripExact"
  ],
  "properties": {
    "schema": {"const": "layered-map-parity-event-v18"},
    "eventType": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/eventType"},
    "sequence": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/sequence"},
    "timestampEpochMillis": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/timestampEpochMillis"},
    "player": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/player"},
    "label": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/label"},
    "teleported": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/teleported"},
    "from": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/from"},
    "to": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/to"},
    "delta": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/delta"},
    "interestDelta": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/interestDelta"},
    "packedCoverage": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/packedCoverage"},
    "tileSnapshot": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/tileSnapshot"},
    "tileParity": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/tileParity"},
    "tileNeighborhood": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/tileNeighborhood"},
    "adjacentCollision": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/adjacentCollision"},
    "recentTraversal": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/recentTraversal"},
    "regionResidency": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/regionResidency"},
    "interestOwnership": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/interestOwnership"},
    "regionRetirement": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/regionRetirement"},
    "regionRetirementDecisions": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/regionRetirementDecisions"},
    "packedRegionRetirementReadiness": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/packedRegionRetirementReadiness"},
    "packedRegionRetirementSafety": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/packedRegionRetirementSafety"},
    "packedRegionAuthoredConstruction": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/packedRegionAuthoredConstruction"},
    "packedRegionAuthoredProvenance": {
      "oneOf": [
        {"$ref": "#/$defs/packedRegionAuthoredProvenance"},
        {"type": "null"}
      ]
    },
    "roundTripExact": {"$ref": "layered-map-parity-event-v17.schema.json#/properties/roundTripExact"}
  },
  "allOf": [
    {"$ref": "layered-map-parity-event-v17.schema.json#/allOf/0"},
    {"$ref": "layered-map-parity-event-v17.schema.json#/allOf/1"},
    {"$ref": "layered-map-parity-event-v17.schema.json#/allOf/2"},
    {"$ref": "layered-map-parity-event-v17.schema.json#/allOf/3"},
    {"$ref": "layered-map-parity-event-v17.schema.json#/allOf/4"},
    {"$ref": "layered-map-parity-event-v17.schema.json#/allOf/5"},
    {
      "if": {"properties": {"packedRegionRetirementSafety": {"type": "null"}}},
      "then": {
        "properties": {"packedRegionAuthoredProvenance": {"type": "null"}}
      }
    }
  ],
  "$defs": {
    "nullableNonnegativeInteger": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "authoredProvenanceAnomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anomalyKind", "generation", "packedRegionX", "packedRegionY",
        "sourceOrdinal", "constructionKind", "manifestRecognized",
        "authoredDefinitionId", "expectedConstructedEntityId", "packedX",
        "packedY", "runtimeObserved", "runtimeEntityId",
        "currentPackedRegionX", "currentPackedRegionY", "runtimeActive",
        "runtimeInstanceCount", "replacementObjectInstanceCount"
      ],
      "properties": {
        "anomalyKind": {
          "enum": [
            "ABSENT", "DUPLICATE", "REPLACEMENT_OBJECT",
            "STALE_GENERATION", "UNRECOGNIZED_IDENTITY"
          ]
        },
        "generation": {"type": "integer", "minimum": 1},
        "packedRegionX": {"type": "integer", "minimum": 0},
        "packedRegionY": {"type": "integer", "minimum": 0},
        "sourceOrdinal": {"type": "integer", "minimum": 1, "maximum": 262144},
        "constructionKind": {
          "enum": [
            "SCENERY", "BOUNDARY", "NPC_SPAWN", "GROUND_ITEM_SPAWN",
            "HARVESTING_SCENERY"
          ]
        },
        "manifestRecognized": {"type": "boolean"},
        "authoredDefinitionId": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "expectedConstructedEntityId": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "packedX": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "packedY": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "runtimeObserved": {"type": "boolean"},
        "runtimeEntityId": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "currentPackedRegionX": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "currentPackedRegionY": {"$ref": "#/$defs/nullableNonnegativeInteger"},
        "runtimeActive": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "null"}
          ]
        },
        "runtimeInstanceCount": {"type": "integer", "minimum": 0, "maximum": 524288},
        "replacementObjectInstanceCount": {"type": "integer", "minimum": 0, "maximum": 524288}
      },
      "allOf": [
        {
          "if": {"properties": {"manifestRecognized": {"const": true}}},
          "then": {
            "properties": {
              "authoredDefinitionId": {"type": "integer"},
              "expectedConstructedEntityId": {"type": "integer"},
              "packedX": {"type": "integer"},
              "packedY": {"type": "integer"}
            }
          },
          "else": {
            "properties": {
              "authoredDefinitionId": {"type": "null"},
              "expectedConstructedEntityId": {"type": "null"},
              "packedX": {"type": "null"},
              "packedY": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"runtimeObserved": {"const": true}}},
          "then": {
            "properties": {
              "runtimeEntityId": {"type": "integer"},
              "currentPackedRegionX": {"type": "integer"},
              "currentPackedRegionY": {"type": "integer"},
              "runtimeActive": {"type": "boolean"}
            }
          },
          "else": {
            "properties": {
              "runtimeEntityId": {"type": "null"},
              "currentPackedRegionX": {"type": "null"},
              "currentPackedRegionY": {"type": "null"},
              "runtimeActive": {"type": "null"}
            }
          }
        }
      ]
    },
    "packedRegionAuthoredProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation", "safetyObservedAtTick", "runtimeObservedAtTick",
        "sourceCount", "expectedPlacementCount", "matchedIdentityCount",
        "absentIdentityCount", "duplicateIdentityCount", "runtimeInstanceCount",
        "activeRuntimeInstanceCount", "inactiveRuntimeInstanceCount",
        "atAuthoredSourceInstanceCount", "awayFromAuthoredSourceInstanceCount",
        "replacementObjectInstanceCount", "staleGenerationInstanceCount",
        "unrecognizedIdentityInstanceCount", "expectedSceneryCount",
        "expectedBoundaryCount", "expectedNpcSpawnCount",
        "expectedGroundItemSpawnCount", "expectedHarvestingSceneryCount",
        "runtimeSceneryCount", "runtimeBoundaryCount", "runtimeNpcSpawnCount",
        "runtimeGroundItemSpawnCount", "runtimeHarvestingSceneryCount",
        "anomalyDetailCount", "droppedAnomalyDetailCount",
        "identityMetadataOnly", "entityRegistry", "lifecycleAuthority",
        "anomalyDetails", "entries"
      ],
      "properties": {
        "generation": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/generation"},
        "safetyObservedAtTick": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/safetyObservedAtTick"},
        "runtimeObservedAtTick": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/runtimeObservedAtTick"},
        "sourceCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/sourceCount"},
        "expectedPlacementCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/expectedPlacementCount"},
        "matchedIdentityCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/matchedIdentityCount"},
        "absentIdentityCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/absentIdentityCount"},
        "duplicateIdentityCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/duplicateIdentityCount"},
        "runtimeInstanceCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/runtimeInstanceCount"},
        "activeRuntimeInstanceCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/activeRuntimeInstanceCount"},
        "inactiveRuntimeInstanceCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/inactiveRuntimeInstanceCount"},
        "atAuthoredSourceInstanceCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/atAuthoredSourceInstanceCount"},
        "awayFromAuthoredSourceInstanceCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/awayFromAuthoredSourceInstanceCount"},
        "replacementObjectInstanceCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/replacementObjectInstanceCount"},
        "staleGenerationInstanceCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/staleGenerationInstanceCount"},
        "unrecognizedIdentityInstanceCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/unrecognizedIdentityInstanceCount"},
        "expectedSceneryCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/expectedSceneryCount"},
        "expectedBoundaryCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/expectedBoundaryCount"},
        "expectedNpcSpawnCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/expectedNpcSpawnCount"},
        "expectedGroundItemSpawnCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/expectedGroundItemSpawnCount"},
        "expectedHarvestingSceneryCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/expectedHarvestingSceneryCount"},
        "runtimeSceneryCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/runtimeSceneryCount"},
        "runtimeBoundaryCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/runtimeBoundaryCount"},
        "runtimeNpcSpawnCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/runtimeNpcSpawnCount"},
        "runtimeGroundItemSpawnCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/runtimeGroundItemSpawnCount"},
        "runtimeHarvestingSceneryCount": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenance/properties/runtimeHarvestingSceneryCount"},
        "anomalyDetailCount": {"type": "integer", "minimum": 0, "maximum": 4096},
        "droppedAnomalyDetailCount": {"type": "integer", "minimum": 0},
        "identityMetadataOnly": {"const": true},
        "entityRegistry": {"const": false},
        "lifecycleAuthority": {"const": false},
        "anomalyDetails": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/authoredProvenanceAnomaly"}
        },
        "entries": {
          "type": "array",
          "maxItems": 8192,
          "items": {"$ref": "layered-map-parity-event-v17.schema.json#/$defs/packedRegionAuthoredProvenanceEntry"}
        }
      }
    }
  }
}
