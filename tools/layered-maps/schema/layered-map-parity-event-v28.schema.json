{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v28.schema.json",
  "title": "Layered Map Parity Event v28",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "packedRegionRetirementSafety",
    "packedRegionAuthoredConstruction", "packedRegionAuthoredProvenance",
    "packedRegionAuthoredReconstruction",
    "packedRegionAuthoredReconstructionCohort",
    "packedRegionAuthoredReconstructionCohortAttribution",
    "packedRegionAuthoredReconstructionTopology",
    "packedRegionAuthoredReconstructionDependencySemantics",
    "packedRegionActiveNpcResidency", "packedRegionActiveNpcContainment",
    "packedRegionActiveNpcBoundaryRequirements",
    "packedRegionRetirementRefinement", "roundTripExact"
  ],
  "properties": {
    "schema": {"const": "layered-map-parity-event-v28"},
    "eventType": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/eventType"},
    "sequence": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/sequence"},
    "timestampEpochMillis": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/timestampEpochMillis"},
    "player": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/player"},
    "label": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/label"},
    "teleported": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/teleported"},
    "from": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/from"},
    "to": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/to"},
    "delta": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/delta"},
    "interestDelta": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/interestDelta"},
    "packedCoverage": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedCoverage"},
    "tileSnapshot": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/tileSnapshot"},
    "tileParity": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/tileParity"},
    "tileNeighborhood": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/tileNeighborhood"},
    "adjacentCollision": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/adjacentCollision"},
    "recentTraversal": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/recentTraversal"},
    "regionResidency": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/regionResidency"},
    "interestOwnership": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/interestOwnership"},
    "regionRetirement": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/regionRetirement"},
    "regionRetirementDecisions": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/regionRetirementDecisions"},
    "packedRegionRetirementReadiness": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionRetirementReadiness"},
    "packedRegionRetirementSafety": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionRetirementSafety"},
    "packedRegionAuthoredConstruction": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionAuthoredConstruction"},
    "packedRegionAuthoredProvenance": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionAuthoredProvenance"},
    "packedRegionAuthoredReconstruction": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionAuthoredReconstruction"},
    "packedRegionAuthoredReconstructionCohort": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionAuthoredReconstructionCohort"},
    "packedRegionAuthoredReconstructionCohortAttribution": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionAuthoredReconstructionCohortAttribution"},
    "packedRegionAuthoredReconstructionTopology": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionAuthoredReconstructionTopology"},
    "packedRegionAuthoredReconstructionDependencySemantics": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionAuthoredReconstructionDependencySemantics"},
    "packedRegionActiveNpcResidency": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionActiveNpcResidency"},
    "packedRegionActiveNpcContainment": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionActiveNpcContainment"},
    "packedRegionActiveNpcBoundaryRequirements": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/packedRegionActiveNpcBoundaryRequirements"},
    "packedRegionRetirementRefinement": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/retirementRefinementProposal"}
      ]
    },
    "roundTripExact": {"$ref": "layered-map-parity-event-v27.schema.json#/properties/roundTripExact"}
  },
  "allOf": [
    {
      "if": {"properties": {"packedRegionRetirementSafety": {"type": "null"}}},
      "then": {"properties": {"packedRegionRetirementRefinement": {"type": "null"}}}
    },
    {
      "if": {"properties": {"packedRegionAuthoredReconstructionCohort": {"type": "null"}}},
      "then": {"properties": {"packedRegionRetirementRefinement": {"type": "null"}}}
    },
    {
      "if": {"properties": {"packedRegionActiveNpcBoundaryRequirements": {"type": "null"}}},
      "then": {"properties": {"packedRegionRetirementRefinement": {"type": "null"}}}
    }
  ],
  "$defs": {
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "boundedCount": {"type": "integer", "minimum": 0, "maximum": 8192},
    "candidateSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packedRegionX", "packedRegionY", "originalSafetySource",
        "authoredCohortSource", "authoredExpansionRound",
        "externalStaticSupportSource", "staticSupportOwnerSourceCount",
        "staticSupportPlacementReferenceCount",
        "selectedOwnerCurrentSourceInstanceCount",
        "externalOwnerAuthoredSourceInstanceCount",
        "activeNpcBoundaryInstanceCount", "activeNpcBoundarySource",
        "addedBeyondOriginalSafety", "freshSafetyEvidenceRequired",
        "freshNpcCensusRequired"
      ],
      "properties": {
        "packedRegionX": {"$ref": "#/$defs/nonNegativeInteger"},
        "packedRegionY": {"$ref": "#/$defs/nonNegativeInteger"},
        "originalSafetySource": {"type": "boolean"},
        "authoredCohortSource": {"type": "boolean"},
        "authoredExpansionRound": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonNegativeInteger"}
          ]
        },
        "externalStaticSupportSource": {"type": "boolean"},
        "staticSupportOwnerSourceCount": {"$ref": "#/$defs/boundedCount"},
        "staticSupportPlacementReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "selectedOwnerCurrentSourceInstanceCount": {"$ref": "#/$defs/boundedCount"},
        "externalOwnerAuthoredSourceInstanceCount": {"$ref": "#/$defs/boundedCount"},
        "activeNpcBoundaryInstanceCount": {"$ref": "#/$defs/boundedCount"},
        "activeNpcBoundarySource": {"type": "boolean"},
        "addedBeyondOriginalSafety": {"type": "boolean"},
        "freshSafetyEvidenceRequired": {"type": "boolean"},
        "freshNpcCensusRequired": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"authoredCohortSource": {"const": true}}},
          "then": {"properties": {"authoredExpansionRound": {"type": "integer"}}},
          "else": {"properties": {"authoredExpansionRound": {"type": "null"}}}
        },
        {
          "if": {"properties": {"addedBeyondOriginalSafety": {"const": true}}},
          "then": {"properties": {
            "freshSafetyEvidenceRequired": {"const": true},
            "freshNpcCensusRequired": {"const": true}
          }},
          "else": {"properties": {
            "freshSafetyEvidenceRequired": {"const": false},
            "freshNpcCensusRequired": {"const": false}
          }}
        }
      ]
    },
    "supportRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packedRegionX", "packedRegionY", "ownerSourceCount",
        "placementReferenceCount", "candidateSource",
        "externalStaticSupportRequired"
      ],
      "properties": {
        "packedRegionX": {"$ref": "#/$defs/nonNegativeInteger"},
        "packedRegionY": {"$ref": "#/$defs/nonNegativeInteger"},
        "ownerSourceCount": {"$ref": "#/$defs/boundedCount"},
        "placementReferenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "candidateSource": {"type": "boolean"},
        "externalStaticSupportRequired": {"const": true}
      }
    },
    "retirementRefinementProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation", "safetyObservedAtTick", "censusObservedAtTick",
        "originalSafetySourceCount", "authoredCohortSourceCount",
        "expandedAuthoredSourceCount", "activeNpcRequirementSourceCount",
        "candidateSourceCount", "addedCandidateSourceCount",
        "activeNpcAndAuthoredOverlapSourceCount",
        "externalSupportRequirementSourceCount",
        "supportPromotedToCandidateSourceCount",
        "hardBlockingConditionCount", "hardBlockingEvidenceCount",
        "boundaryContainedAtInput", "nonExpandableHardBlockers",
        "freshSafetyAssessmentRequired", "freshNpcCensusRequired",
        "reassessmentRequired", "candidateSelectionMutated",
        "fixedPointClosureProved", "loadRequest", "entityRegistry",
        "arrivalGate", "lifecycleAuthority", "candidates",
        "externalSupportRequirements"
      ],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "safetyObservedAtTick": {"$ref": "#/$defs/nonNegativeInteger"},
        "censusObservedAtTick": {"$ref": "#/$defs/nonNegativeInteger"},
        "originalSafetySourceCount": {"$ref": "#/$defs/boundedCount"},
        "authoredCohortSourceCount": {"$ref": "#/$defs/boundedCount"},
        "expandedAuthoredSourceCount": {"$ref": "#/$defs/boundedCount"},
        "activeNpcRequirementSourceCount": {"$ref": "#/$defs/boundedCount"},
        "candidateSourceCount": {"$ref": "#/$defs/boundedCount"},
        "addedCandidateSourceCount": {"$ref": "#/$defs/boundedCount"},
        "activeNpcAndAuthoredOverlapSourceCount": {"$ref": "#/$defs/boundedCount"},
        "externalSupportRequirementSourceCount": {"$ref": "#/$defs/boundedCount"},
        "supportPromotedToCandidateSourceCount": {"$ref": "#/$defs/boundedCount"},
        "hardBlockingConditionCount": {"type": "integer", "minimum": 0, "maximum": 4},
        "hardBlockingEvidenceCount": {"$ref": "#/$defs/nonNegativeInteger"},
        "boundaryContainedAtInput": {"type": "boolean"},
        "nonExpandableHardBlockers": {"type": "boolean"},
        "freshSafetyAssessmentRequired": {"const": true},
        "freshNpcCensusRequired": {"const": true},
        "reassessmentRequired": {"const": true},
        "candidateSelectionMutated": {"const": false},
        "fixedPointClosureProved": {"const": false},
        "loadRequest": {"const": false},
        "entityRegistry": {"const": false},
        "arrivalGate": {"const": false},
        "lifecycleAuthority": {"const": false},
        "candidates": {
          "type": "array", "maxItems": 8192,
          "items": {"$ref": "#/$defs/candidateSource"}
        },
        "externalSupportRequirements": {
          "type": "array", "maxItems": 8192,
          "items": {"$ref": "#/$defs/supportRequirement"}
        }
      }
    }
  }
}
