{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v48.schema.json",
  "title": "Layered Map Parity Event v48",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "packedRegionRetirementSafety",
    "packedRegionAuthoredConstruction", "packedRegionAuthoredProvenance",
    "packedRegionAuthoredReconstruction",
    "packedRegionAuthoredReconstructionCohort",
    "packedRegionAuthoredReconstructionCohortAttribution",
    "packedRegionAuthoredReconstructionTopology",
    "packedRegionAuthoredReconstructionDependencySemantics",
    "packedRegionActiveNpcResidency", "packedRegionActiveNpcContainment",
    "packedRegionActiveNpcBoundaryRequirements",
    "packedRegionRetirementRefinement",
    "packedRegionRetirementRefinementReassessment",
    "packedRegionPreservationBurden",
    "packedRegionDynamicObjectPreservation", "packedRegionEventOwnership",
    "packedRegionNpcOwnerEventContinuity",
    "packedRegionNpcOwnerPreservationBoundary",
    "packedRegionNpcOwnerPreservationNoOp", "packedRegionEventTargets",
    "packedRegionEventAtomicTargetRevalidation",
    "packedRegionEventRecoveryNoOp", "roundTripExact"
  ],
  "properties": {
    "schema": { "const": "layered-map-parity-event-v48" },
    "eventType": {
      "enum": [
        "start", "snapshot", "marker", "move", "teleport", "login",
        "logout", "stop", "recovery-noop", "preservation-noop"
      ]
    },
    "sequence": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/sequence" },
    "timestampEpochMillis": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/timestampEpochMillis" },
    "player": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/player" },
    "label": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/label" },
    "teleported": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/teleported" },
    "from": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/from" },
    "to": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/to" },
    "delta": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/delta" },
    "interestDelta": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/interestDelta" },
    "packedCoverage": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedCoverage" },
    "tileSnapshot": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/tileSnapshot" },
    "tileParity": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/tileParity" },
    "tileNeighborhood": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/tileNeighborhood" },
    "adjacentCollision": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/adjacentCollision" },
    "recentTraversal": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/recentTraversal" },
    "regionResidency": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/regionResidency" },
    "interestOwnership": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/interestOwnership" },
    "regionRetirement": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/regionRetirement" },
    "regionRetirementDecisions": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/regionRetirementDecisions" },
    "packedRegionRetirementReadiness": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionRetirementReadiness" },
    "packedRegionRetirementSafety": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionRetirementSafety" },
    "packedRegionAuthoredConstruction": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionAuthoredConstruction" },
    "packedRegionAuthoredProvenance": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionAuthoredProvenance" },
    "packedRegionAuthoredReconstruction": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionAuthoredReconstruction" },
    "packedRegionAuthoredReconstructionCohort": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionAuthoredReconstructionCohort" },
    "packedRegionAuthoredReconstructionCohortAttribution": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionAuthoredReconstructionCohortAttribution" },
    "packedRegionAuthoredReconstructionTopology": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionAuthoredReconstructionTopology" },
    "packedRegionAuthoredReconstructionDependencySemantics": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionAuthoredReconstructionDependencySemantics" },
    "packedRegionActiveNpcResidency": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionActiveNpcResidency" },
    "packedRegionActiveNpcContainment": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionActiveNpcContainment" },
    "packedRegionActiveNpcBoundaryRequirements": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionActiveNpcBoundaryRequirements" },
    "packedRegionRetirementRefinement": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionRetirementRefinement" },
    "packedRegionRetirementRefinementReassessment": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionRetirementRefinementReassessment" },
    "packedRegionPreservationBurden": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionPreservationBurden" },
    "packedRegionDynamicObjectPreservation": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionDynamicObjectPreservation" },
    "packedRegionEventOwnership": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionEventOwnership" },
    "packedRegionNpcOwnerEventContinuity": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionNpcOwnerEventContinuity" },
    "packedRegionNpcOwnerPreservationBoundary": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionNpcOwnerPreservationBoundary" },
    "packedRegionNpcOwnerPreservationNoOp": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/npcOwnerPreservationNoOp" }
      ]
    },
    "packedRegionEventTargets": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionEventTargets" },
    "packedRegionEventAtomicTargetRevalidation": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionEventAtomicTargetRevalidation" },
    "packedRegionEventRecoveryNoOp": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/packedRegionEventRecoveryNoOp" },
    "roundTripExact": { "$ref": "layered-map-parity-event-v47.schema.json#/properties/roundTripExact" }
  },
  "$defs": {
    "npcOwnerPreservationNoOp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason", "generation", "requirementsObservedAtTick",
        "selectedSourceCount", "requiredEventLinkCount",
        "requiredOwnerCount", "ownerScopeEntered",
        "sourceLifecycleInvoked", "absentSourceCount",
        "reconstructedSourceCount", "preservedConsumerInvoked",
        "preservationEstablishedForConsumedWork", "preservationPerformed",
        "sourceAbsencePerformed", "sourceReconstructionPerformed",
        "regionMutationPerformed", "runtimeHandleRetained", "arrivalGate",
        "visibilityReleased", "lifecycleAuthority"
      ],
      "properties": {
        "reason": {
          "enum": ["OWNER_SCOPE_REFUSED", "SOURCE_LIFECYCLE_UNAVAILABLE"]
        },
        "generation": { "type": "integer", "minimum": 0 },
        "requirementsObservedAtTick": { "type": "integer", "minimum": 0 },
        "selectedSourceCount": { "type": "integer", "minimum": 0, "maximum": 8192 },
        "requiredEventLinkCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "requiredOwnerCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "ownerScopeEntered": { "type": "boolean" },
        "sourceLifecycleInvoked": { "type": "boolean" },
        "absentSourceCount": { "const": 0 },
        "reconstructedSourceCount": { "const": 0 },
        "preservedConsumerInvoked": { "const": false },
        "preservationEstablishedForConsumedWork": { "const": false },
        "preservationPerformed": { "const": false },
        "sourceAbsencePerformed": { "const": false },
        "sourceReconstructionPerformed": { "const": false },
        "regionMutationPerformed": { "const": false },
        "runtimeHandleRetained": { "const": false },
        "arrivalGate": { "const": false },
        "visibilityReleased": { "const": false },
        "lifecycleAuthority": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reason": { "const": "OWNER_SCOPE_REFUSED" } },
            "required": ["reason"]
          },
          "then": {
            "properties": {
              "ownerScopeEntered": { "const": false },
              "sourceLifecycleInvoked": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": { "const": "SOURCE_LIFECYCLE_UNAVAILABLE" }
            },
            "required": ["reason"]
          },
          "then": {
            "properties": {
              "ownerScopeEntered": { "const": true },
              "sourceLifecycleInvoked": { "const": true }
            }
          }
        }
      ]
    }
  }
}
