{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schema/layered-map-parity-event-v14.schema.json",
  "title": "Layered Map Parity Event v14",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "eventType", "sequence", "timestampEpochMillis", "player",
    "label", "teleported", "from", "to", "delta", "interestDelta",
    "packedCoverage", "tileSnapshot", "tileParity", "tileNeighborhood",
    "adjacentCollision", "recentTraversal", "regionResidency",
    "interestOwnership", "regionRetirement", "regionRetirementDecisions",
    "packedRegionRetirementReadiness", "roundTripExact"
  ],
  "properties": {
    "schema": {"const": "layered-map-parity-event-v14"},
    "eventType": {
      "enum": ["start", "snapshot", "marker", "move", "teleport", "login", "logout", "stop"]
    },
    "sequence": {"type": "integer", "minimum": 1},
    "timestampEpochMillis": {"type": "integer", "minimum": 0},
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseId", "usernameHash"],
      "properties": {
        "databaseId": {"type": "integer", "minimum": 0},
        "usernameHash": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "label": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "teleported": {"type": ["boolean", "null"]},
    "from": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/snapshot"},
        {"type": "null"}
      ]
    },
    "to": {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/snapshot"},
    "delta": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/delta"},
        {"type": "null"}
      ]
    },
    "interestDelta": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/interestDelta"},
        {"type": "null"}
      ]
    },
    "packedCoverage": {
      "$ref": "layered-map-parity-event-v11.schema.json#/$defs/packedCoverage"
    },
    "tileSnapshot": {
      "$ref": "layered-map-parity-event-v11.schema.json#/$defs/tileSnapshot"
    },
    "tileParity": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/tileParity"},
        {"type": "null"}
      ]
    },
    "tileNeighborhood": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/tileNeighborhood"},
        {"type": "null"}
      ]
    },
    "adjacentCollision": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/adjacentCollision"},
        {"type": "null"}
      ]
    },
    "recentTraversal": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/recentTraversal"},
        {"type": "null"}
      ]
    },
    "regionResidency": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/regionResidency"},
        {"type": "null"}
      ]
    },
    "interestOwnership": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v11.schema.json#/$defs/interestOwnership"},
        {"type": "null"}
      ]
    },
    "regionRetirement": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v12.schema.json#/$defs/regionRetirement"},
        {"type": "null"}
      ]
    },
    "regionRetirementDecisions": {
      "oneOf": [
        {"$ref": "layered-map-parity-event-v13.schema.json#/$defs/regionRetirementDecisions"},
        {"type": "null"}
      ]
    },
    "packedRegionRetirementReadiness": {
      "oneOf": [
        {"$ref": "#/$defs/packedRegionRetirementReadiness"},
        {"type": "null"}
      ]
    },
    "roundTripExact": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {"enum": ["start", "marker", "teleport", "stop"]}
        }
      },
      "then": {
        "properties": {
          "tileParity": {
            "$ref": "layered-map-parity-event-v11.schema.json#/$defs/tileParity"
          },
          "tileNeighborhood": {
            "$ref": "layered-map-parity-event-v11.schema.json#/$defs/tileNeighborhood"
          },
          "adjacentCollision": {
            "$ref": "layered-map-parity-event-v11.schema.json#/$defs/adjacentCollision"
          }
        }
      },
      "else": {
        "properties": {
          "tileParity": {"type": "null"},
          "tileNeighborhood": {"type": "null"},
          "adjacentCollision": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"eventType": {"enum": ["marker", "stop"]}}},
      "else": {"properties": {"recentTraversal": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": ["start", "snapshot", "marker", "teleport", "login", "logout", "stop"]
          }
        }
      },
      "then": {
        "properties": {
          "interestOwnership": {
            "$ref": "layered-map-parity-event-v11.schema.json#/$defs/interestOwnership"
          }
        }
      }
    },
    {
      "if": {"properties": {"regionRetirementDecisions": {"type": "null"}}},
      "then": {
        "properties": {"packedRegionRetirementReadiness": {"type": "null"}}
      },
      "else": {
        "properties": {
          "packedRegionRetirementReadiness": {
            "$ref": "#/$defs/packedRegionRetirementReadiness"
          }
        }
      }
    }
  ],
  "$defs": {
    "packedRegionRetirementReadinessEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packedRegionX", "packedRegionY", "coveredLogicalRegions",
        "missingLogicalDecisions", "refusedLogicalDecisions",
        "partialResidencyLogicalDecisions", "spansLevels", "sourceState"
      ],
      "properties": {
        "packedRegionX": {"type": "integer", "minimum": 0},
        "packedRegionY": {"type": "integer", "minimum": 0},
        "coveredLogicalRegions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "layered-map-parity-event-v11.schema.json#/$defs/regionKey"
          }
        },
        "missingLogicalDecisions": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "layered-map-parity-event-v11.schema.json#/$defs/regionKey"
          }
        },
        "refusedLogicalDecisions": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "layered-map-parity-event-v11.schema.json#/$defs/regionKey"
          }
        },
        "partialResidencyLogicalDecisions": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "layered-map-parity-event-v11.schema.json#/$defs/regionKey"
          }
        },
        "spansLevels": {"type": "boolean"},
        "sourceState": {
          "enum": [
            "READY", "INCOMPLETE_COVERAGE", "REFUSED_COVERAGE",
            "PARTIAL_RESIDENCY", "PARTIAL_LEGACY_DOMAIN"
          ]
        }
      }
    },
    "packedRegionRetirementReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAtTick", "ownershipVersion", "residencyMirrorVersion",
        "logicalDecisionCount", "sourceCount", "readySourceCount",
        "blockedSourceCount", "entries"
      ],
      "properties": {
        "observedAtTick": {"type": "integer", "minimum": -1},
        "ownershipVersion": {"type": "integer", "minimum": -1},
        "residencyMirrorVersion": {"type": "integer", "minimum": -1},
        "logicalDecisionCount": {"type": "integer", "minimum": 0, "maximum": 4096},
        "sourceCount": {"type": "integer", "minimum": 0, "maximum": 8192},
        "readySourceCount": {"type": "integer", "minimum": 0, "maximum": 8192},
        "blockedSourceCount": {"type": "integer", "minimum": 0, "maximum": 8192},
        "entries": {
          "type": "array",
          "maxItems": 8192,
          "items": {"$ref": "#/$defs/packedRegionRetirementReadinessEntry"}
        }
      }
    }
  }
}
