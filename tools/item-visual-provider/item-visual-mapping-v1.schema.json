{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoiled-milk.invalid/schemas/world-builder-item-visual-mapping-v1.json",
  "title": "World Builder item visual mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestType",
    "provider",
    "assetProviders",
    "selection",
    "itemVisuals"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestType": { "const": "world-builder-item-visual-mapping" },
    "provider": {
      "type": "object",
      "required": ["identity", "definitionMode", "catalogItemCount", "catalogSha256", "inputs"]
    },
    "assetProviders": {
      "type": "object",
      "required": ["customSpriteArchive", "authenticSpriteArchive", "externalPngPackaging"]
    },
    "selection": {
      "type": "object",
      "required": ["kind", "itemCount", "itemIdsSha256", "mappingSha256"]
    },
    "itemVisuals": {
      "type": "array",
      "items": { "$ref": "#/$defs/itemVisual" }
    }
  },
  "$defs": {
    "nullableObject": {
      "oneOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "itemVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "diagnosticName",
        "spriteLocation",
        "spriteId",
        "resolvedBaseSourceRole",
        "authenticArchive",
        "customOrSpritepack",
        "externalPng",
        "pictureMask",
        "blueMask"
      ],
      "properties": {
        "itemId": { "type": "integer", "minimum": 0 },
        "diagnosticName": { "type": ["string", "null"] },
        "spriteLocation": { "type": ["string", "null"] },
        "spriteId": { "type": "integer" },
        "resolvedBaseSourceRole": {
          "enum": ["custom-sprite-archive", "external-png", "authentic-archive-fallback"]
        },
        "authenticArchive": { "$ref": "#/$defs/nullableObject" },
        "customOrSpritepack": { "$ref": "#/$defs/nullableObject" },
        "externalPng": { "$ref": "#/$defs/nullableObject" },
        "pictureMask": { "type": "integer" },
        "blueMask": { "type": "integer" }
      }
    }
  }
}
