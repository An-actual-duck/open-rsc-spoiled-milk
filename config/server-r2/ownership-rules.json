      "reason": "Layered-package proof fixture"
    },
    {
      "pattern": "tools/layered-maps/**",
      "category": "tool-only",
      "reason": "Layered-map schema, generator, or validation tool"
    },
    {
      "pattern": "scripts/benchmark-server.sh",
      "category": "diagnostic-proof",
      "reason": "Server performance diagnostic input"
    },
    {
      "pattern": "server/lib/**",
      "category": "foundation",
      "reason": "Ant-authoritative runtime dependency"
    },
    {
      "pattern": "server/src/**",
      "category": "foundation",
      "reason": "Current Ant core source; direct content signals are recorded separately as debt"
