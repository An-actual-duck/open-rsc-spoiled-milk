    {
      "pattern": "server/src/com/openrsc/server/content/LegacyAmuletCompatibility.java",
      "category": "maintained-compatibility",
      "reason": "Named maintained gameplay compatibility facade"
    },
    {
      "pattern": "server/src/com/openrsc/server/content/**",
      "category": "unresolved",
      "reason": "Mixed inherited/custom content owner requires an R2 extraction decision"
    },
    {
      "pattern": "server/plugins/com/openrsc/server/plugins/custom/**",
