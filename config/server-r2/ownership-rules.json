  "brandSignals": {
    "want-myworld-flag": "(?i)\\bWANT_MYWORLD\\b|\\bwant_myworld\\b",
    "myworld-name": "(?i)\\bmyworld\\b|MyWorld",
    "spoiled-milk-name": "(?i)spoiled[ _-]?milk",
    "myworld-plugin-namespace": "com\\.openrsc\\.server\\.plugins\\.custom\\.myworld"
