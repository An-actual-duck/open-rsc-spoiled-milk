{
  "schemaVersion": 1,
  "evidenceBaseCommit": "6e1720900bbdccd46ba06b9726ac7e91a89b56f3",
  "categories": [
    "foundation",
    "target-profile",
    "spoiled-milk-content",
    "maintained-compatibility",
    "tool-only",
    "diagnostic-proof",
    "unresolved"
  ],
  "inputScope": {
    "includePrefixes": [
      "server/",
      "release/world-builder-v2/",
      "tools/layered-maps/"
    ],
    "includeExact": [
      "scripts/audit-server-build.py",
      "scripts/benchmark-server.sh",
      "scripts/build-server.sh",
      "scripts/deploy-live-main.sh",
      "scripts/export-landscape-map.sh",
      "scripts/import-landscape-map.sh",
      "scripts/init-sqlite.sh",
      "scripts/lib/layered-world-package.sh",
      "scripts/lib/myworld-common.sh",
      "scripts/package-world-builder-v2-release.sh",
      "scripts/run-hosted-server.sh",
      "scripts/run-server.sh",
      "scripts/run-server-zgc.sh",
      "scripts/stop-hosted-server.sh"
    ],
    "excludePrefixes": [
      "server/.run/",
      "server/avatars/",
      "server/logs/",
      "server/test/",
      "tools/layered-maps/workspace/",
      "tools/layered-maps/build/"
    ],
    "excludeExact": [
      "server/.gitignore",
      "server/SERVER.md",
      "tools/layered-maps/.gitignore",
      "tools/layered-maps/README.md"
    ]
  },
  "rules": [
