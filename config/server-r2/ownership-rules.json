      "reason": "Bounded server diagnostics and parity evidence"
    },
    {
      "pattern": "server/src/com/openrsc/server/constants/custom/MyWorld*",
      "category": "spoiled-milk-content",
      "reason": "Explicit MyWorld content identity catalog"
    },
    {
      "pattern": "server/src/com/openrsc/server/content/cleric/**",
      "category": "spoiled-milk-content",
      "reason": "Spoiled Milk Cleric content"
    },
    {
      "pattern": "server/src/com/openrsc/server/content/minigame/monsterslayer/**",
      "category": "spoiled-milk-content",
      "reason": "Spoiled Milk Monster Slayer content"
    },
    {
      "pattern": "server/src/com/openrsc/server/content/minigame/combatodyssey/**",
      "category": "spoiled-milk-content",
      "reason": "Spoiled Milk Combat Odyssey content"
    },
    {
      "pattern": "server/src/com/openrsc/server/content/{BadLuckMitigation,CorrosiveAura,Devotion,DevotionHalfOfferingBalance,DivineGrace,DivineRetribution,EnchantingItemEffects,FutureMedallionCatalog,GodArtifacts,Leach,PoisonPower,PoisonProcChance,RangersGuildArea,RangersGuildPoints,SkillCapes,Summoning,TrueDefense}.java",
